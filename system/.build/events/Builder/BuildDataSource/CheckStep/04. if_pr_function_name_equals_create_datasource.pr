      "RawResponse": "{\n  \"Reasoning\": \"The user wants to check if the variable %pr.Function.Name% is equal to the string 'CreateDataSource'. This is a simple equality condition, so the IsEqual function is the most appropriate to use. It compares two values for equality and returns true if they match.\",\n  \"Name\": \"IsEqual\",\n  \"Parameters\": [\n    {\n      \"Type\": \"System.Object\",\n      \"Name\": \"item1\",\n      \"Value\": \"%pr.Function.Name%\"\n    },\n    {\n      \"Type\": \"System.Object\",\n      \"Name\": \"item2\",\n      \"Value\": \"CreateDataSource\"\n    },\n    {\n      \"Type\": \"PLang.Models.GoalToCallInfo\",\n      \"Name\": \"goalToCallIfTrue\",\n      \"Value\": null\n    },\n    {\n      \"Type\": \"PLang.Models.GoalToCallInfo\",\n      \"Name\": \"goalToCallIfFalse\",\n      \"Value\": null\n    },\n    {\n      \"Type\": \"System.Boolean\",\n      \"Name\": \"ignoreCase\",\n      \"Value\": true\n    },\n    {\n      \"Type\": \"PLang.Modules.ThrowErrorModule.ErrorInfo\",\n      \"Name\": \"throwErrorOnTrue\",\n      \"Value\": null\n    },\n    {\n      \"Type\": \"PLang.Modules.ThrowErrorModule.ErrorInfo\",\n      \"Name\": \"throwErrorOnFalse\",\n      \"Value\": null\n    }\n  ],\n  \"ReturnValues\": null\n}",
