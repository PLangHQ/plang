,\"Name\":\"item\",\"IsRequired\":true},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"Description\":\"Is a value empty or null, e.g. `if %question% is empty then`. This is the dedicated method for that test and is the one to use, rather than SimpleCondition with its isEmpty operator\",\"MethodName\":\"IsEmpty\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item\",\"IsRequired\":true},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false,\"Examples\":[\"if %id% is empty then call Create, else call Update => item=%id%, goalTocallIfTrue={Name=\\\"Create\\\"}, goalToCallifFalse={Name=\\\"Update\\\"}\",\"if %name% is empty then throw => item=%name%, throwErrorOnTrue=...generate ErrorInfo\"]},{\"Description\":\"example: `if %code% contains 123, 345 then ....`, `if %zip% is one of (223,333) then...`\",\"MethodName\":\"ContainsNumbers\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item\",\"Description\":\"The value being tested, the left side of the comparison\",\"IsRequired\":true},{\"Type\":\"System.Collections.Generic.List`1[System.Int32]\",\"Name\":\"contains\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"Description\":\"isNot property reverse true to false, example: `if %name% contains \\\"john\\\" then`, `if %product% contains %title% then call goal DoProdudct`, `if %name% does not contain \\\"bill\\\"` (isNot=true)\",\"MethodName\":\"ContainsString\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item\",\"Description\":\"The value being tested, the left side of the comparison, e.g. %name% in `if %name% contains \\\"john\\\"`\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"contains\",\"Description\":\"What it is tested against, the right side, e.g. \\\"john\\\" in `if %name% contains \\\"john\\\"`\",\"IsRequired\":true},{\"Type\":\"System.Boolean\",\"Name\":\"isNot\",\"DefaultValue\":false,\"Description\":\"true when the step negates the test, e.g. `does not contain`, `does not start with`, `is not`. false when the step states the test plainly\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"Description\":\"isNot property reverse true to false, example: `if %name% starts with \\\"john\\\" then`, `if %source% starts with \\\"t\\\" then call goal Track`, `if %name% does not start with \\\"bill\\\"` (isNot=true). Use ignoreCase=true to compare case insensitive.\",\"MethodName\":\"StartsWith\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item\",\"Description\":\"The value being tested, the left side of the comparison, e.g. %path% in `if %path% starts with \\\"/\\\"`\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"startsWith\",\"Description\":\"What it is tested against, the right side, e.g. \\\"/\\\" in `if %path% starts with \\\"/\\\"`\",\"IsRequired\":true},{\"Type\":\"System.Boolean\",\"Name\":\"isNot\",\"DefaultValue\":false,\"Description\":\"true when the step negates the test, e.g. `does not contain`, `does not start with`, `is not`. false when the step states the test plainly\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"ignoreCase\",\"DefaultValue\":false,\"Description\":\"true when letter case must not matter in the comparison. false unless the step asks for that\",\"Is