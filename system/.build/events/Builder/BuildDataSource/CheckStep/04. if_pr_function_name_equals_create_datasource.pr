t\",\"Name\":\"item\",\"Description\":\"The value being tested, the left side, e.g. %path% in `if %path% ends with \\\".md\\\"`\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"endsWith\",\"Description\":\"What it is tested against, the right side, e.g. \\\".md\\\"\",\"IsRequired\":true},{\"Type\":\"System.Boolean\",\"Name\":\"ignoreCase\",\"DefaultValue\":false,\"Description\":\"true when letter case must not matter. false unless the step asks for that\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"isNot\",\"DefaultValue\":false,\"Description\":\"true when the step negates the test. Prefer the NotEndsWith method, which says it in its name\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false,\"Examples\":[\"if %file% ends with \\\".csv\\\" then => item=\\\"%file%\\\", endsWith=\\\".csv\\\"\"]},{\"Description\":\"For a step that says the value does NOT end with something, e.g. `if %path% does not end with \\\".md\\\" then`. For the positive form use EndsWith.\",\"MethodName\":\"NotEndsWith\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item\",\"Description\":\"The value being tested, the left side, e.g. %path% in `if %path% does not end with \\\".md\\\"`\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"endsWith\",\"Description\":\"What it is tested against, the right side, e.g. \\\".md\\\"\",\"IsRequired\":true},{\"Type\":\"System.Boolean\",\"Name\":\"ignoreCase\",\"DefaultValue\":false,\"Description\":\"true when letter case must not matter. false unless the step asks for that\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false,\"Examples\":[\"if %file% does not end with \\\".tmp\\\" then => item=\\\"%file%\\\", endsWith=\\\".tmp\\\"\"]},{\"MethodName\":\"IsNotEqual\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item1\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"item2\",\"IsRequired\":true},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"ignoreCase\",\"DefaultValue\":true,\"Description\":\"true is the normal case, letter case does not matter. false only when the step asks for an exact, case sensitive comparison\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"Description\":\"Check if item equals(==) another object. \\n`if %id% == 100 then call IsCorrectNumber, else DoSomeThingElse....` => IsCorrectNumber is goalToCallIfTrue, DoSomeThingElse is goalToCallIfFalse\\n`if %name% is 'john'....`\\n`if %zip equals 123....\\n\",\"MethodName\":\"IsEqual\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"item1\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"item2\",\"IsRequired\":true},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"ignoreCase\",\"DefaultValue\":true,\"Description\":\"true is the normal case, letter case does not matter. false only when the step asks for an exact, case sensitive comparison\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"Description\":\"Choose RunInlineCode when no other method matches user intent. Implementation variable can be set to null.\",\"MethodName\":\"RunInlineCode\",\"Parameters\":[{\"Type\":\"PLang.Services.CompilerService.ConditionImplementationResponse\",\"Name\":\"implementation\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":true}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false}],\"SupportingObjects\":[{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"Name of goal and parameters that is called, e.g. in condition, loops, run goal. Keep Name as user defines it with path\",\"TypeProperties\":[{\"Type\":\"System.String\",\"Name\":\"Name\",\"IsRequired\":true},{\"Type\":\"System.Collections.Generic.Dictionary`2[System.String,System.Object]\",\"Name\":\"Parameters\",\"Description\":\"The named values handed to the goal being called, and only those: they are what the step writes for that call, e.g. `call goal Chat id=%chatId%` passes id. Each entry's name is written to the LEFT of the = and its value to the RIGHT, so `call goal SignIn next=\\\"/admin/Overview\\\"` is {\\\"next\\\": \\\"/admin/Overview\\\"}: the wrapping quotes are dropped, and the value is never the name written back as %next%. Empty whenever the step names the goal and nothing else, e.g. `on tool call, call ToolUsed`. A variable the step uses for its own work is not passed on just by being in the step\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"statusCode default is 400\",\"TypeProperties\":[{\"Type\":\"System.String\",\"Name\":\"Message\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Type\",\"IsRequired\":true},{\"Type\":\"System.Int32\",\"Name\":\"StatusCode\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"Key\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+SimpleCondition\",\"Name\":\"condition\",\"Description\":\"One test. Shape:\\n{\\\"Kind\\\":\\\"Simple\\\",\\\"LeftValue\\\":\\\"%age%\\\",\\\"Operator\\\":\\\">=\\\",\\\"RightValue\\\":18,\\\"IsNot\\\":false}\\nOperator: ==|!=|<|>|<=|>=|in|notIn|isEmpty|isNotEmpty|contains|notContains|startswith|notStartswith|endswith|notEndswith|indexOf.\\nA test written in the negative takes the negative operator, and IsNot stays false:\\n  `%city% is empty`               => Operator isEmpty\\n  `%city% is not empty`           => Operator isNotEmpty\\n  `%city% contains \\\"x\\\"`           => Operator contains\\n  `%city% does not contain \\\"x\\\"`   => Operator notContains\\n  `%city% does not start with \\\"x\\\"`=> Operator notStartswith\\nIsNot exists for a negation the operators cannot express and is false otherwise. Never write a positive operator for a test the step writes in the negative: that is the opposite step, and it runs without anything noticing.\\nA Simple NEVER has Logic or Conditions: a step joining two tests is a Compound.\",\"TypeProperties\":[{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+ConditionKind\",\"Name\":\"Kind\",\"AvailableValues\":\"Simple|Compound\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"LeftValue\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Operator\",\"IsRequired\":false},{\"Type\":\"System.Object\",\"Name\":\"RightValue\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Logic\",\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.IReadOnlyList`1[PLang.Modules.ConditionalModule.ConditionEvaluator+Condition]\",\"Name\":\"Conditions\",\"Description\":\"One test. Shape:\\n{\\\"Kind\\\":\\\"Simple\\\",\\\"LeftValue\\\":\\\"%age%\\\",\\\"Operator\\\":\\\">=\\\",\\\"RightValue\\\":18,\\\"IsNot\\\":false}\\nOperator: ==|!=|<|>|<=|>=|in|notIn|isEmpty|isNotEmpty|contains|notContains|startswith|notStartswith|endswith|notEndswith|indexOf.\\nA test written in the negative takes the negative operator, and IsNot stays false:\\n  `%city% is empty`               => Operator isEmpty\\n  `%city% is not empty`           => Operator isNotEmpty\\n  `%city% contains \\\"x\\\"`           => Operator contains\\n  `%city% does not contain \\\"x\\\"`   => Operator notContains\\n  `%city% does not start with \\\"x\\\"`=> Operator notStartswith\\nIsNot exists for a negation the operators cannot express and is false otherwise. Never write a positive operator for a test the step writes in the negative: that is the opposite step, and it runs without anything noticing.\\nA Simple NEVER has Logic or Conditions: a step joining two tests is a Compound.\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"IsNot\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+CompoundCondition\",\"Name\":\"condition\",\"Description\":\"Two or more tests joined together. Shape:\\n{\\\"Kind\\\":\\\"Compound\\\",\\\"Logic\\\":\\\"AND\\\",\\\"IsNot\\\":false,\\\"Conditions\\\":[{\\\"Kind\\\":\\\"Simple\\\",...},{\\\"Kind\\\":\\\"Simple\\\",...}]}\\nLogic is AND or OR and is required. Conditions holds the tests being joined.\\nEach test inside is read from its own words, e.g. `%city% is empty and %name% is not empty` joins one with Operator isEmpty and one with Operator isNotEmpty. Joining tests does not make them positive.\\nA Compound NEVER has LeftValue, Operator or RightValue of its own: those belong to the Simple conditions inside it.\",\"TypeProperties\":[{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+ConditionKind\",\"Name\":\"Kind\",\"AvailableValues\":\"Simple|Compound\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"LeftValue\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Operator\",\"IsRequired\":false},{\"Type\":\"System.Object\",\"Name\":\"RightValue\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Logic\",\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.IReadOnlyList`1[PLang.Modules.ConditionalModule.ConditionEvaluator+Condition]\",\"Name\":\"Conditions\",\"Description\":\"Two or more tests joined together. Shape:\\n{\\\"Kind\\\":\\\"Compound\\\",\\\"Logic\\\":\\\"AND\\\",\\\"IsNot\\\":false,\\\"Conditions\\\":[{\\\"Kind\\\":\\\"Simple\\\",...},{\\\"Kind\\\":\\\"Simple\\\",...}]}\\nLogic is AND or OR and is required. Conditions holds the tests being joined.\\nEach test inside is read from its own words, e.g. `%city% is empty and %name% is not empty` joins one with Operator isEmpty and one with Operator isNotEmpty. Joining tests does not make them positive.\\nA Compound NEVER has LeftValue, Operator or RightValue of its own: those belong to the Simple conditions inside it.\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"IsNot\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"PLang.Services.CompilerService.ConditionImplementationResponse\",\"Name\":\"implementation\",\"TypeProperties\":[{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"GoalToCallOnTrue\",\"Description\":\"(see PLang.Models.GoalToCallInfo type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"GoalToCallOnFalse\",\"Description\":\"(see PLang.Models.GoalToCallInfo type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Reasoning\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"Namespace\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"Name\",\"IsRequired\":true},{\"Type\":\"System.Collections.Generic.List`1[System.String]\",\"Name\":\"Using\",\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.List`1[System.String]\",\"Name\":\"Assemblies\",\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.List`1[PLang.Modules.BaseBuilder+Parameter]\",\"Name\":\"Parameters\",\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.List`1[PLang.Modules.BaseBuilder+ReturnValue]\",\"Name\":\"ReturnValues\",\"IsRequired\":false}],\"IsRequired\":false}]}\n## functions available ends ##\n## defined variables ##\npr.Function.Name (type:object), \n## defined variables ##"
            }
