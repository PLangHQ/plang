ins|startswith|endswith|indexOf.  IsNot property indicates if the condition is a negation of the specified operator. True for ‘is not’, ‘does not’, etc.\",\"MethodName\":\"CompoundCondition\",\"Parameters\":[{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+CompoundCondition\",\"Name\":\"condition\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":true},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErrorModule.ErrorInfo\",\"Name\":\"throwErrorOnFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"MethodName\":\"SetVariableWithCondition\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"variableName\",\"IsRequired\":true},{\"Type\":\"System.Boolean\",\"Name\":\"boolValue\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"valueIfTrue\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"valueIfFalse\",\"IsRequired\":true}],\"ReturnRequired\":false},{\"MethodName\":\"IsFalse\",\"Parameters\":[{\"Type\":\"System.Nullable`1[System.Boolean]\",\"Name\":\"item\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfTrue\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalToCallIfFalse\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":false},{\"Type\":\"PLang.Modules.ThrowErro