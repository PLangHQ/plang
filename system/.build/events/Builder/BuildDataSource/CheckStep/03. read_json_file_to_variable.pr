      ],
      "type": "PLang.Modules.FileModule.Builder",
      "caching": true,
      "RawResponse": "{\n  \"Reasoning\": \"The user wants to read a JSON file from a specified relative path and store the parsed JSON content into the variable %pr%. The ReadJson function matches this intent as it reads a JSON file and returns the content as an object.\",\n  \"Name\": \"ReadJson\",\n  \"Parameters\": [\n    {\n      \"Type\": \"System.String\",\n      \"Name\": \"path\",\n      \"Value\": \"/%item.RelativePrPath%\"\n    },\n    {\n      \"Type\": \"System.Boolean\",\n      \"Name\": \"throwErrorOnNotFound\",\n      \"Value\": true\n    },\n    {\n      \"Type\": \"System.Boolean\",\n      \"Name\": \"loadVariables\",\n      \"Value\": false\n    },\n    {\n      \"Type\": \"System.Boolean\",\n      \"Name\": \"emptyVariableIfNotFound\",\n      \"Value\": false\n    },\n    {\n      \"Type\": \"System.String\",\n      \"Name\": \"encoding\",\n      \"Value\": \"utf-8\"\n    },\n    {\n      \"Type\": \"System.Boolean\",\n      \"Name\": \"allowReadingFromSystem\",\n      \"Value\": false\n    }\n  ],\n  \"ReturnValues\": [\n    {\n      \"Type\": \"System.Object\",\n      \"VariableName\": \"%pr%\"\n    }\n  ]\n}",
      "Tools": null
    }
  ]
