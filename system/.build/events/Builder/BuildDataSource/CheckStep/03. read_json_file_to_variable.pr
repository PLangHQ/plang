{
  "Text": "read json file \"/%item.RelativePrPath%\", write to %pr%",
  "ModuleType": "PLang.Modules.FileModule",
  "GenericFunctionType": "PLang.Modules.BaseBuilder+GenericFunction",
  "Function": {
    "Reasoning": "The user wants to read a JSON file from a specified relative path and store the parsed JSON content into the variable %pr%. The ReadJson function matches this intent as it reads a JSON file and returns the content as an object.",
    "Name": "ReadJson",
    "Parameters": [
      {
        "Type": "System.String",
        "Name": "path",
        "Value": "/%item.RelativePrPath%"
      },
      {
        "Type": "System.Boolean",
        "Name": "throwErrorOnNotFound",
        "Value": true
      },
      {
        "Type": "System.Boolean",
        "Name": "loadVariables",
        "Value": false
      },
      {
        "Type": "System.Boolean",
        "Name": "emptyVariableIfNotFound",
        "Value": false
      },
      {
        "Type": "System.String",
        "Name": "encoding",
        "Value": "utf-8"
      },
      {
        "Type": "System.Boolean",
        "Name": "allowReadingFromSystem",
        "Value": false
      }
    ],
    "ReturnValues": [
      {
        "Type": "System.Object",
        "VariableName": "%pr%"
      }
    ]
  },
  "Properties": {
    "Parameters": {
      "path": {
        "Name": "path",
        "FullTypeName": "System.String"
      },
      "throwErrorOnNotFound": {
        "Name": "throwErrorOnNotFound",
        "FullTypeName": "System.Boolean"
      },
      "loadVariables": {
        "Name": "loadVariables",
        "FullTypeName": "System.Boolean"
      },
