        "Name": "emptyVariableIfNotFound",
        "FullTypeName": "System.Boolean"
      },
      "encoding": {
        "Name": "encoding",
        "FullTypeName": "System.String"
      },
      "allowReadingFromSystem": {
        "Name": "allowReadingFromSystem",
