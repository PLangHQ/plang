      "RawResponse": "{\n  \"Reasoning\": \"The user wants to throw an error using the provided error object %!error%. The Throw method matches this intent as it allows throwing an error with a message object.\",\n  \"Name\": \"Throw\",\n  \"Parameters\": [\n    {\n      \"Type\": \"System.Object\",\n      \"Name\": \"message\",\n      \"Value\": \"%!error%\"\n    },\n    {\n      \"Type\": \"System.String\",\n      \"Name\": \"key\",\n      \"Value\": \"UserDefinedError\"\n    },\n    {\n      \"Type\": \"System.Int32\",\n      \"Name\": \"statusCode\",\n      \"Value\": 400\n    },\n    {\n      \"Type\": \"System.String\",\n      \"Name\": \"fixSuggestion\",\n      \"Value\": null\n    },\n    {\n      \"Type\": \"System.String\",\n      \"Name\": \"helpfullLinks\",\n      \"Value\": null\n    }\n  ],\n  \"ReturnValues\": null\n}",
