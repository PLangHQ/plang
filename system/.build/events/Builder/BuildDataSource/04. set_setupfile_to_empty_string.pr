ry.day%\\\", \\\"\\\"]\",\"set %goals% = %q.goals%, default is [] => keyValues.key=\\\"%goals%\\\", value=[\\\"%q.goals%\\\", []]\",\"set %target% = %request.body.target%, default is \\\"#body\\\" => keyValues.key=\\\"%target%\\\", value=[\\\"%request.body.target%\\\", \\\"#body\\\"]\"]},{\"Description\":\"Append to variable. valueLocation=postfix|prefix seperatorLocation=end|start\",\"MethodName\":\"AppendToVariable\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"key\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"value\",\"IsRequired\":false},{\"Type\":\"System.Char\",\"Name\":\"seperator\",\"DefaultValue\":\"\\n\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"valueLocation\",\"DefaultValue\":\"postfix\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"seperatorLocation\",\"DefaultValue\":\"end\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"shouldBeUnique\",\"DefaultValue\":false,\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"doNotLoadVariablesInValue\",\"DefaultValue\":false,\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"MethodName\":\"GetVariable\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"key\",\"IsRequired\":true}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"MethodName\":\"RemoveVariables\",\"Parameters\":[{\"Type\":\"System.String[]\",\"Name\":\"keys\",\"IsRequired\":true}],\"ReturnRequired\":false},{\"Description\":\"Sets a value to %Settings.XXXX% variable\",\"MethodName\":\"SetSettingValue\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"key\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"value\",\"IsRequired\":true}],\"ReturnRequired\":false},{\"Description\":\"Sets a value to %Settings.XXXX% variable but only if it is not set before\",\"MethodName\":\"SetDefaultSettingValue\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"key\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"value\",\"IsRequired\":true}],\"ReturnRequired\":false},{\"MethodName\":\"ConvertToBase64\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"key\",\"IsRequired\":true}],\"ReturnValue\":{\"Type\":\"System.String\"},\"ReturnRequired\":false},{\"Description\":\"Modifies a DateTime by applying one or more operations.\",\"MethodName\":\"ModifyDateTime\",\"Parameters\":[{\"Type\":\"PLang.Modules.VariableModule.Program+ModifyDateTimeParameters\",\"Name\":\"p\",\"Description\":\"(see Type information in SupportingObjects)\",\"IsRequired\":true}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false,\"Examples\":[\"remove 1 day from %fromDate%, format 'yyyy-MM-dd' => Operations=[{Method='AddDays', Parameters=[-1]}], Format='yyyy-MM-dd'\",\"add 3 months to %startDate% => Operations=[{Method='AddMonths', Parameters=[3]}]\",\"subtract 2 hours from %timestamp% => Operations=[{Method='AddHours', Parameters=[-2]}]\",\"remove 26 hours from %now% => Operations=[{Method='AddHours', Parameters=[-26]}]\",\"set %date% as %now% but add one month then subtract 2 days => Operations=[{Method='AddMonths', Parameters=[1]}, {Method='AddDays', Parameters=[-2]}]\",\"take %startDate%, add 1 year, add 6 months, subtract 1 day => Operations=[{Method='AddYears', Parameters=[1]}, {Method='AddMonths', Parameters=[6]}, {Method='AddDays', Parameters=[-1]}]\",\"add %months% months then %days% days to %date%, format 'yyyy-MM-dd' => Operations=[{Method='AddMonths', Parameters=[%months%]}, {Method='AddDays', Parameters=[%days%]}], Format='yyyy-MM-dd'\"]},{\"MethodName\":\"TrimForLlm\",\"Parameters\":[{\"Type\":\"System.Object\",\"Name\":\"obj\",\"IsRequired\":true},{\"Type\":\"System.Int32\",\"Name\":\"maxItemCount\",\"DefaultValue\":30,\"IsRequired\":false},{\"Type\":\"System.Nullable`1[System.Int32]\",\"Name\":\"maxItemLength\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"groupOn\",\"IsRequired\":false},{\"Type\":\"System.Int32\",\"Name\":\"samplesPerGroup\",\"DefaultValue\":5,\"IsRequired\":false},{\"Type\":\"System.Int32\",\"Name\":\"listLimit\",\"DefaultValue\":50,\"IsRequired\":false},{\"Type\":\"System.Int32\",\"Name\":\"totalCharsLimit\",\"DefaultValue\":2000,\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"formatJson\",\"DefaultValue\":false,\"IsRequired\":false}],\"ReturnValue\":{\"Type\":\"System.Object\"},\"ReturnRequired\":false},{\"MethodName\":\"GetSettings\",\"Parameters\":[{\"Type\":\"System.String\",\"Name\":\"key\",\"IsRequired\":true}],\"ReturnRequired\":false}],\"SupportingObjects\":[{\"Type\":\"PLang.Models.GoalToCallInfo\",\"Name\":\"goalName\",\"Description\":\"Name of goal and parameters that is called, e.g. in condition, loops, run goal. Keep Name as user defines it with path\",\"TypeProperties\":[{\"Type\":\"System.String\",\"Name\":\"Name\",\"IsRequired\":true},{\"Type\":\"System.Collections.Generic.Dictionary`2[System.String,System.Object]\",\"Name\":\"Parameters\",\"Description\":\"The named values handed to the goal being called, and only those: they are what the step writes for that call, e.g. `call goal Chat id=%chatId%` passes id. Each entry's name is written to the LEFT of the = and its value to the RIGHT, so `call goal SignIn next=\\\"/admin/Overview\\\"` is {\\\"next\\\": \\\"/admin/Overview\\\"}: the wrapping quotes are dropped, and the value is never the name written back as %next%. Empty whenever the step names the goal and nothing else, e.g. `on tool call, call ToolUsed`. A variable the step uses for its own work is not passed on just by being in the step\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+SimpleCondition\",\"Name\":\"simpleCondition\",\"Description\":\"One test. Shape:\\n{\\\"Kind\\\":\\\"Simple\\\",\\\"LeftValue\\\":\\\"%age%\\\",\\\"Operator\\\":\\\">=\\\",\\\"RightValue\\\":18,\\\"IsNot\\\":false}\\nOperator: ==|!=|<|>|<=|>=|in|notIn|isEmpty|isNotEmpty|contains|notContains|startswith|notStartswith|endswith|notEndswith|indexOf.\\nA test written in the negative takes the negative operator, and IsNot stays false:\\n  `%city% is empty`               => Operator isEmpty\\n  `%city% is not empty`           => Operator isNotEmpty\\n  `%city% contains \\\"x\\\"`           => Operator contains\\n  `%city% does not contain \\\"x\\\"`   => Operator notContains\\n  `%city% does not start with \\\"x\\\"`=> Operator notStartswith\\nIsNot exists for a negation the operators cannot express and is false otherwise. Never write a positive operator for a test the step writes in the negative: that is the opposite step, and it runs without anything noticing.\\nA Simple NEVER has Logic or Conditions: a step joining two tests is a Compound.\",\"TypeProperties\":[{\"Type\":\"PLang.Modules.ConditionalModule.ConditionEvaluator+ConditionKind\",\"Name\":\"Kind\",\"AvailableValues\":\"Simple|Compound\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"LeftValue\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Operator\",\"IsRequired\":false},{\"Type\":\"System.Object\",\"Name\":\"RightValue\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"Logic\",\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.IReadOnlyList`1[PLang.Modules.ConditionalModule.ConditionEvaluator+Condition]\",\"Name\":\"Conditions\",\"Description\":\"One test. Shape:\\n{\\\"Kind\\\":\\\"Simple\\\",\\\"LeftValue\\\":\\\"%age%\\\",\\\"Operator\\\":\\\">=\\\",\\\"RightValue\\\":18,\\\"IsNot\\\":false}\\nOperator: ==|!=|<|>|<=|>=|in|notIn|isEmpty|isNotEmpty|contains|notContains|startswith|notStartswith|endswith|notEndswith|indexOf.\\nA test written in the negative takes the negative operator, and IsNot stays false:\\n  `%city% is empty`               => Operator isEmpty\\n  `%city% is not empty`           => Operator isNotEmpty\\n  `%city% contains \\\"x\\\"`           => Operator contains\\n  `%city% does not contain \\\"x\\\"`   => Operator notContains\\n  `%city% does not start with \\\"x\\\"`=> Operator notStartswith\\nIsNot exists for a negation the operators cannot express and is false otherwise. Never write a positive operator for a test the step writes in the negative: that is the opposite step, and it runs without anything noticing.\\nA Simple NEVER has Logic or Conditions: a step joining two tests is a Compound.\",\"IsRequired\":false},{\"Type\":\"System.Boolean\",\"Name\":\"IsNot\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"System.Collections.Generic.List`1[PLang.Modules.VariableModule.Program+VariableIfEmpty]\",\"Name\":\"variables\",\"Description\":\"Type should be c# object type, e.g. System.String, System.DateTime, etc. When undefined, set to System.Object\",\"TypeProperties\":[{\"Type\":\"System.String\",\"Name\":\"Name\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"FirstValue\",\"IsRequired\":true},{\"Type\":\"System.Object\",\"Name\":\"ValueIfFirstIsEmpty\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"Type\",\"IsRequired\":true}],\"IsRequired\":false},{\"Type\":\"PLang.Modules.VariableModule.Program+ModifyDateTimeParameters\",\"Name\":\"p\",\"Description\":\"Applies one or more modifications to a DateTime.\",\"TypeProperties\":[{\"Type\":\"System.DateTime\",\"Name\":\"DateTime\",\"IsRequired\":true},{\"Type\":\"PLang.Modules.VariableModule.Program+ModifyDateTimeOperation[]\",\"Name\":\"Operations\",\"IsRequired\":true},{\"Type\":\"System.String\",\"Name\":\"Format\",\"IsRequired\":false},{\"Type\":\"System.String\",\"Name\":\"CultureInfo\",\"IsRequired\":false}],\"IsRequired\":false}]}\n## functions available ends ##\n## defined variables ##\nsetupFile (type:object), \n## defined variables ##"
            }
