<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>plang</AssemblyName>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <SignAssembly>False</SignAssembly>
		<PublishSingleFile>false</PublishSingleFile>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PLang\PLang.csproj" />
  </ItemGroup>

  <!-- The system and os goals ship with plang and sit next to plang.dll (PrParser looks in AppContext.BaseDirectory/system). A publish
       copies them, a build does not, so a build still runs from the folders of the repository. .db folders are never copied. -->
  <ItemGroup>
    <Content Include="..\system\**\*" Exclude="..\system\**\.db\**" Link="system\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <Content Include="..\os\**\*" Exclude="..\os\**\.db\**" Link="os\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
	
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
		<UseAppHost>true</UseAppHost>
		<MacOSAppBundle>true</MacOSAppBundle>
		<OutputType>Exe</OutputType>
		<RuntimeIdentifier>$(RuntimeIdentifier)</RuntimeIdentifier>
		<!--
		<ApplicationIcon>Icon.icns</ApplicationIcon>
		 Optional: if you have an app icon -->
		<IntermediateOutputPath>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</IntermediateOutputPath>
		<CodesignKey>Developer ID Application: Ingi Gauti</CodesignKey>
		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
		<!-- Optional: if you have entitlements -->
	</PropertyGroup>

	<!-- Include the custom Info.plist -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
		<BundleResource Include="Info.plist" />
	</ItemGroup>

</Project>
