<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>plang</AssemblyName>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <SignAssembly>False</SignAssembly>
		<PublishSingleFile>false</PublishSingleFile>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
		<!-- every restore, a publish's for another runtime too, keeps the assets of the machine's own runtime, which a dev
		     build (below) runs on -->
		<RuntimeIdentifiers>$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PLang\PLang.csproj" />
  </ItemGroup>
	
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
		<UseAppHost>true</UseAppHost>
		<MacOSAppBundle>true</MacOSAppBundle>
		<OutputType>Exe</OutputType>
		<RuntimeIdentifier>$(RuntimeIdentifier)</RuntimeIdentifier>
		<!--
		<ApplicationIcon>Icon.icns</ApplicationIcon>
		 Optional: if you have an app icon -->
		<IntermediateOutputPath>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</IntermediateOutputPath>
		<CodesignKey>Developer ID Application: Ingi Gauti</CodesignKey>
		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
		<!-- Optional: if you have entitlements -->
	</PropertyGroup>

	<!-- Include the custom Info.plist -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
		<BundleResource Include="Info.plist" />
	</ItemGroup>

	<!-- A build with no runtime named (dev, the gate) runs on the machine that builds it: its native assets are that
	     machine's alone, not every runtime's. The output stays bin/<config>/net10.0/plang. A publish names its runtime
	     (-r). After the osx block, so a Mac's dev build is no app bundle. -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And '$(Configuration)' != 'Release'">
		<RuntimeIdentifier>$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifier>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<!-- <OutDir>/os links to the repo's os tree, so /system/* resolves to the live os/system tree during dev. -->
	<Import Project="..\os.targets" />
	<Import Project="..\native.targets" />

</Project>
