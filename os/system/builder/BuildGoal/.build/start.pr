  "child": [
    {
      "name": "Compile",
      "comment": "The three stages for the goal in %goal% — shared by the top goal and every sub-goal. The decider\nanswers WHICH actions a step may use; the LLM writes each step's actions in formal; the steps read\nthe answer, each checking its own line, and take their code. A step refused goes back to the LLM\nalone; an else written apart from its if is the programmer's to fix, not the LLM's.",
      "step": [
        {
          "index": 0,
