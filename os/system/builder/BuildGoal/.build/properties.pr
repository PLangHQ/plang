            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%propertiesUserMsg%",
              "variable": [
                {
                  "text": "%propertiesUserMsg%",
                  "code": [
                    {
                      "variable": "propertiesUserMsg"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%!data%",
              "variable": [
                {
                  "text": "%!data%",
                  "code": [
                    {
                      "variable": "!data"
                    }
                  ]
                }
              ]
            }
          ],
          "default": [
            {
              "name": "asdefault",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ],
      "waitForExecution": true
    },
