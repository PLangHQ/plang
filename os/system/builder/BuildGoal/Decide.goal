Decide
/ Decide which actions every step of this goal uses — the whole goal in two exchanges with the
/ decider, not one LLM call per step.
/
/ The decider is generic: it takes a state and typed questions and answers them. It knows nothing
/ about goals or steps. Everything goal-shaped is composed HERE: the state and the questions are
/ templates (the words), and each step's Pick reads the answers (the numbers).
/
/ Stage 1 asks, per step, one choice — which module does the main work — and a yes/no per common
/ action (decider.json). Stage 2 asks only what stage 1 left open, which each step's Pick decides:
/ the main module's action, a runner-up module, whether the step uses a module it scored under
/ certain, an if's branches, and on a step stage 1 was unsure of, which popular action it uses.

- set %modules% = %!app.module.list%
- read "/system/builder/llm/decider.json", write to %decider%

- set %stage% = 1
- render template "/system/builder/llm/templates/decider.state.template", write to %state%
- render template "/system/builder/llm/templates/decider1.template", write to %questions%
- llm.decider State=%state%, Question=%questions%, write to %answer%
- build.pick Goal=%goal%, Answer=%answer%, Popular=%decider.popular%

- set %stage% = 2
- render template "/system/builder/llm/templates/decider.state.template", write to %state%
- render template "/system/builder/llm/templates/decider2.template", write to %questions%
- llm.decider State=%state%, Question=%questions%, write to %answer%
- build.pick Goal=%goal%, Answer=%answer%, Popular=%decider.popular%

- call /system/builder/EmitBuildEvent kind="goal-decided", goal=%goal%
