{% comment %}
Stage 2 of the decider — the questions stage 1 leaves open, per step. WHICH questions are asked is the
step's Pick (step.Pick.Question: its id and what it is about — a module, an action, a branch, the
popular options); this template only writes their words. The question keys and wording are pinned
by PickListTests (PLang.Tests/Wire/App/Decider/pick_golden.json).
{% endcomment %}
{
{%- assign sep = "" -%}
{%- for s in goal.Step -%}
{%- assign text = s.Text -%}
{%- comment %}the step's variables whose type the build's walk knows (step.Typed): a window variable points at the
window module itself{% endcomment -%}
{%- capture typed %}{% for v in s.Typed %} %{{ v.Name }}% is a {{ v.Type }}.{% endfor %}{% endcapture -%}
{%- for q in s.Pick.Question -%}
{{ sep }}
  {{ q.Id | json }}: {
{%- case q.Kind -%}
{%- when "Popular" -%}
{%- capture ask %}Step {{ s.Index }} is `{{ text }}`. Which of these actions does step {{ s.Index }} use?{% endcapture %}
    "type": "choice",
    "criteria": {
{%- assign osep = "" -%}
{%- for o in q.Option -%}
{%- capture name %}{{ o.Module.Name }}.{{ o.Name }}{% endcapture -%}
{{ osep }}{{ name | json }}: null
{%- assign osep = ", " -%}
{%- endfor -%}
},
    "instructions": {{ ask | json }}
{%- when "Branch" -%}
{%- assign about = q.Branch.Description | strip -%}
{%- capture ask %}Step {{ s.Index }} is `{{ text }}`. It tests a condition. Does step {{ s.Index }} also have `{{ q.Branch.Module.Name }}.{{ q.Branch.Name }}` — {{ about }}?{% endcapture %}
    "type": "noul",
    "instructions": {{ ask | json }}
{%- when "Use" -%}
{%- if q.Also %}{% assign also = " also" %}{% else %}{% assign also = "" %}{% endif -%}
{%- capture ask %}Step {{ s.Index }} is `{{ text }}`.{{ typed }} Does step {{ s.Index }}{{ also }} use the plang module `{{ q.Module.Name }}`?{% endcapture %}
    "type": "noul",
    "instructions": {{ ask | json }}
{%- when "Action" -%}
{%- capture ask %}Step {{ s.Index }} of this goal is `{{ text }}`.{{ typed }} It uses the plang module `{{ q.Module.Name }}`. Which action of `{{ q.Module.Name }}` does step {{ s.Index }} call?{% endcapture %}
    "type": "choice",
    "instructions": {{ ask | json }},
    "criteria": {
{%- assign osep = "" -%}
{%- for o in q.Option -%}
{%- assign about = o.Description | strip -%}
{{ osep }}{{ o.Name | json }}: {{ about | json }}
{%- assign osep = ", " -%}
{%- endfor -%}
}
{%- when "Option" -%}
{%- capture ask %}Step {{ s.Index }} is `{{ text }}`. {{ q.Ask }}{% endcapture %}
    "type": "choice",
    "instructions": {{ ask | json }},
    "criteria": {
{%- assign osep = "" -%}
{%- for v in q.Values -%}
{{ osep }}{{ v | json }}: null
{%- assign osep = ", " -%}
{%- endfor -%}
}
{%- endcase %}
  }
{%- assign sep = "," -%}
{%- endfor -%}
{%- endfor %}
}
