{%- assign mn = p | split: "." | first -%}
{%- assign an = p | split: "." | last -%}
{%- assign m = modules | where: "Name", mn | first -%}
{%- assign a = m.Action | concat: m.Modifier | where: "Name", an | first -%}
{%- assign about = a.Description | strip -%}
{{ nl }}- {{ p }}: {{ about }}
{%- endfor -%}
{%- endif -%}
