{%- for s in goal.Step -%}
step {{ s.Index }}: {% if s.Indent > 0 %}{% for i in (1..s.Indent) %}    {% endfor %}{% endif %}{{ s.Text }}{{ nl }}
{%- endfor -%}
{{ nl }}These are the plang modules you may choose from:
{%- if stage == 2 -%}
{%- assign used = "" -%}
{%- assign unsure = false -%}
{%- for s in goal.Step -%}
{%- for m in s.Pick.Module -%}{%- assign used = used | append: m.Name | append: "," -%}{%- endfor -%}
{%- if s.Pick.IsCondition -%}{%- assign used = used | append: "condition," -%}{%- endif -%}
{%- if s.Pick.IsUnsure -%}{%- assign unsure = true -%}{%- endif -%}
{%- endfor -%}
{%- assign names = used | split: "," | uniq | sort -%}
{%- else -%}
{%- assign names = modules | map: "Name" | sort -%}
{%- endif -%}
{%- for n in names -%}
{%- if n == "" -%}{%- continue -%}{%- endif -%}
{%- assign m = modules | where: "Name", n | first -%}
{%- assign about = m.Description | strip -%}
{{ nl }}- {{ n }}: {{ about }}
{%- if m.Notes -%}{%- assign notes = m.Notes | strip -%}{{ nl }}  notes: {{ notes }}{%- endif -%}
{%- assign acts = m.Action | concat: m.Modifier | sort: "Name" -%}
{%- for a in acts -%}
{%- if a.Examples -%}
{%- assign parts = "|" | append: a.Examples | split: "Step text: `" -%}
{%- for p in parts offset: 1 -%}
{%- assign ex = p | split: "`" | first -%}
{{ nl }}  e.g. `{{ ex }}`
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- if stage == 2 -%}
{%- for a in acts -%}
{%- assign about = a.Description | strip -%}
{{ nl }}  action {{ n }}.{{ a.Name }}: {{ about }}
{%- if a.Examples -%}{%- assign examples = a.Examples | strip -%}{{ nl }}    examples: {{ examples }}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- if stage == 2 -%}
{%- if unsure -%}
