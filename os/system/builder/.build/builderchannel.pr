{
  "name": "BuilderChannel",
  "step": [
    {
      "index": 0,
      "text": "condition.if(Left=%message%, Operator=\"isnotempty\") { output.write(Data=%message%) }",
      "line": {
        "number": 7
      },
      "comment": "Builder channel sink. Goal-backed channel registered at Build start so all\nbuild-time output flows through one named seam — later we can swap the consumer\n(file log, TUI, structured stream) without touching the call sites.\nWhat the builder writes reaches this goal as its argument %message%.\nAn event the output template has no line for renders empty, and prints nothing.",
      "code": [
        {
          "module": "condition",
          "name": "if",
          "property": [
