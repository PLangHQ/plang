    },
    {
      "index": 3,
      "text": "start terminal '//usr/lib/chromium/chromium' with parameters '--ozone-platform=wayland', '--no-first-run',\n'--no-default-browser-check', '--disable-gpu-compositing', '--use-angle=swiftshader', '--enable-unsafe-swiftshader',\n'--num-raster-threads=4', '--hide-crash-restore-bubble', '--disable-quic',\n'--disable-blink-features=AutomationControlled', '--in-process-gpu',\n'--disable-features=SpareRendererForSitePerProcess,WebUIOmniboxPopup,WebUIOmniboxAimPopup',\n'--user-data-dir=%!app.AbsolutePath%/.browser', '--remote-debugging-pipe',\n'--app=file://%!app.OsAbsolutePath%/system/browser/blank.html',\nwith environment variables XDG_RUNTIME_DIR=\"%!app.AbsolutePath%/.run\" and WAYLAND_DISPLAY=\"wayland-plang\",\nkeep running, with pipe, write to %program%",
      "line": {
        "number": 15
      },
      "code": [
        {
          "module": "terminal",
          "name": "open",
          "property": [
            {
              "name": "App",
              "type": {
                "name": "text"
              },
              "value": "//usr/lib/chromium/chromium"
            },
            {
              "name": "Parameter",
              "type": {
                "name": "list",
                "template": "plang"
              },
              "value": ["--ozone-platform=wayland","--no-first-run","--no-default-browser-check","--disable-gpu-compositing","--use-angle=swiftshader","--enable-unsafe-swiftshader","--num-raster-threads=4","--hide-crash-restore-bubble","--disable-quic","--disable-blink-features=AutomationControlled","--in-process-gpu","--disable-features=SpareRendererForSitePerProcess,WebUIOmniboxPopup,WebUIOmniboxAimPopup","--user-data-dir=%!app.AbsolutePath%/.browser","--remote-debugging-pipe","--app=file://%!app.OsAbsolutePath%/system/browser/blank.html"],
              "variable": [
                {
                  "text": "%!app.AbsolutePath%",
                  "code": [
