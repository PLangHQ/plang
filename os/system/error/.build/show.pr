{
  "name": "Show",
  "step": [
    {
      "index": 0,
      "text": "set %template% = \"/system/error/%error.StatusCode%.txt\"",
      "lineNumber": 5,
      "comment": "Shows an error: the template for its status code in this folder renders it, and it is written to\nthe error channel. The caller hands the error in by name — `call /system/error/Show error=%!error%`\ninside a handler; at the top level the app hands in the failed run's error.",
      "code": [
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "template"
            },
            {
              "name": "Value",
              "type": {
                "name": "text",
                "template": "plang"
              },
              "value": "/system/error/%error.StatusCode%.txt"
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 1,
      "text": "render %template%, error=%error%, on error 404 call Fallback then retry once, write to %text%",
      "lineNumber": 6,
      "code": [
        {
          "module": "ui",
          "name": "render",
          "property": [
            {
