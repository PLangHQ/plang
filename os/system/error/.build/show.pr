        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "text"
            },
            {
              "name": "Value",
              "type": {
                "name": "text"
              },
              "value": "%!data%"
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 2,
      "text": "write %text% to error channel",
      "lineNumber": 7,
      "code": [
