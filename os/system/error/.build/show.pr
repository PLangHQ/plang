      "text": "ui.render(Template=%template%, Parameter={error: %error%}); on.error(Status=404, Recovery=[goal.call(Name=\"Fallback\")], RetryCount=1, Order=\"GoalFirst\"); variable.set(Name=%text%, Value=%!data%)",
