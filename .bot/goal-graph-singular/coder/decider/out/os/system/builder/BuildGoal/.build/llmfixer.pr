{
 "name": "LlmFixer",
 "path": "/os/system/builder/BuildGoal/LlmFixer.goal",
 "step": [
  {
   "index": 0,
   "text": "call /system/builder/EmitBuildEvent kind=\"planner-validation-failed\", errorMessage=%!error.Message%",
   "lineNumber": 6,
   "comment": "Planner produced invalid output \u2014 retry with the prior conversation cached\n(system prompt + goal already in context; only the correction message is new).\nThe error message is sharp enough that the LLM corrects rather than anchors.",
   "waitForExecution": true,
   "action": [
    {
     "module": "system",
     "name": "EmitBuildEvent",
     "parameter": [
      {
       "name": "kind",
       "type": {
        "name": "item"
       },
       "value": "planner-validation-failed"
      },
      {
       "name": "errorMessage",
       "type": {
        "name": "item"
       },
       "value": "%!error.Message%"
      }
     ],
     "modifier": []
    }
   ]
  },
  {
   "index": 1,
   "text": "set %fixerMessages% = [{\"Role\":\"user\", \"Content\":\"Your previous response was rejected: %!error.Message%\\n\\nReturn the corrected plan. Each step's `actions` MUST be a non-empty array of `\\\"module.action\\\"` strings from the catalog (e.g. `\\\"variable.set\\\"`, `\\\"file.read\\\"`). `index` is 0-based.\"}]",
   "lineNumber": 7,
   "waitForExecution": true,
   "action": [
    {
     "module": "variable",
     "name": "set",
     "parameter": [
      {
       "name": "Name",
       "type": {
        "name": "variable"
       },
       "value": "%fixerMessages%"
      },
      {
       "name": "Value",
       "type": {
        "name": "item"
       },
       "value": [
        {
         "Role": "user",
         "Content": "Your previous response was rejected: %!error.Message%\\n\\nReturn the corrected plan. Each step's `actions` MUST be a non-empty array of `\"module.action\"` strings from the catalog (e.g. `\"variable.set\"`, `\"file.read\"`). `index` is 0-based."
        }
       ]
      }
     ],
     "modifier": []
    }
   ]
  },
  {
   "index": 2,
   "text": "llm.query Message=%fixerMessages%, Schema={description: string, steps: list<{index: int, actions: list<string>, confidence: string, explanation?: string}>}, cache=%!build.cache%, previousConversation=%plan%, write to %plan%",
   "lineNumber": 8,
   "waitForExecution": true,
   "action": [
    {
     "module": "llm",
     "name": "query",
     "parameter": [
      {
       "name": "Message",
       "type": {
        "name": "list"
       },
       "value": "%fixerMessages%"
      },
      {
       "name": "Schema",
       "type": {
        "name": "item"
       },
       "value": {
        "description": "string",
        "steps": "list<{index: int, actions: list<string>, confidence: string, explanation?: string}>"
       }
      },
      {
       "name": "Cache",
       "type": {
        "name": "bool"
       },
       "value": "%!build.cache%"
      },
      {
       "name": "previousConversation",
       "type": {
        "name": "item"
       },
       "value": "%plan%"
      },
      {
       "name": "writeTo",
       "type": {
        "name": "item"
       },
       "value": "%plan%"
      }
     ],
     "modifier": [
