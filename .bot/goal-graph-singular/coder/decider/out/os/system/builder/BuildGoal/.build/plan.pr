   "path": "/os/system/builder/BuildGoal/Plan.goal",
   "step": [
    {
     "index": 0,
     "text": "llm.query Message=%messages%, Schema=\"{description: string, steps: list<{index: int, actions: list<string>, confidence: string, error?: string, warning?: string}>}\", cache=%!build.cache%, write to %plan%",
     "lineNumber": 26,
     "waitForExecution": true,
