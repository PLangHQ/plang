          "name": "messages",
          "value": "%messages%"
         }
        ]
       }
      }
     ],
     "modifier": [
      {
       "module": "error",
       "name": "handle",
       "parameter": [
        {
         "name": "RetryCount",
         "type": {
          "name": "number"
         },
         "value": 2
        }
       ],
       "modifier": [],
       "recovery": [
        {
         "module": "goal",
         "name": "call",
         "parameter": [
          {
           "name": "GoalName",
           "type": {
