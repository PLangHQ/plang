{
 "name": "Validate",
 "path": "/os/system/builder/BuildGoal/Validate.goal",
 "step": [
  {
   "index": 0,
   "text": "if %plan.steps.Count% is not %goal.step.Count%, throw error 'Planner returned %plan.steps.Count% step plans but goal has %goal.step.Count% steps.' key=\"LlmTransient\"",
   "lineNumber": 4,
   "comment": "Validate planner response \u2014 one entry per step.",
   "waitForExecution": true,
   "action": [
    {
     "module": "condition",
     "name": "if",
     "parameter": [
      {
       "name": "Left",
       "type": {
        "name": "item"
       },
       "value": "%plan.steps.Count%"
      },
      {
       "name": "Operator",
       "type": {
        "name": "choice"
       },
       "value": "!="
      },
      {
       "name": "Right",
       "type": {
        "name": "item"
       },
       "value": "%goal.step.Count%"
      },
      {
       "name": "Negate",
       "type": {
        "name": "bool"
       },
       "value": false
      }
     ],
     "modifier": []
    },
    {
     "module": "error",
     "name": "throw",
     "parameter": [
      {
       "name": "Message",
       "type": {
        "name": "text"
       },
       "value": "Planner returned %plan.steps.Count% step plans but goal has %goal.step.Count% steps."
      },
      {
       "name": "Key",
       "type": {
        "name": "text"
       },
       "value": "LlmTransient"
      }
     ],
     "modifier": []
    }
   ]
  }
 ],
