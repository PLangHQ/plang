{
  "name": "Modules",
  "step": [
    {
      "index": 0,
      "text": "call goal Page module=%!app.module.file%",
      "line": {
        "number": 8
      },
      "comment": "The learner pages in modules/, each written from the module catalog, never by hand (decision 411; the spec is\nDocumentation/v0.2/module-reference-generation.md): the module's description, then each action's description,\nthe steps of its examples, its properties (how a step says each, its type, whether it is required, its default,\nwhat it changes) and what it returns.\nOnly the file module's notes are tagged yet, so only its page is written. The loop over %!app.module.list% comes\nwhen the other modules' notes are tagged.",
      "code": [
        {
          "module": "goal",
          "name": "call",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "goal"
              },
              "value": "Page"
            },
            {
              "name": "Parameter",
              "type": {
                "name": "list"
              },
              "value": [{"name":"module","type":{"name":"item","template":"plang"},"value":"%!app.module.file%","variable":[{"text":"%!app.module.file%","code":[{"variable":"!app"},{"property":"module"},{"property":"file"}]}]}]
            }
          ],
          "default": [
            {
              "name": "parallel",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ],
      "waitForExecution": true
    }
  ],
  "child": [
    {
      "name": "Page",
      "step": [
        {
          "index": 0,
          "text": "render template \"/templates/module.template\", write to %page%",
          "line": {
            "number": 12
          },
          "comment": "One module's page, modules/<name>.md, then what its actions' notes and properties don't agree on.",
          "code": [
            {
              "module": "ui",
              "name": "render",
              "property": [
                {
                  "name": "Template",
                  "type": {
                    "name": "text"
                  },
                  "value": "/templates/module.template"
                }
              ]
            },
            {
              "module": "variable",
              "name": "set",
              "property": [
                {
                  "name": "Name",
                  "type": {
                    "name": "variable"
                  },
                  "value": "%page%",
                  "variable": [
                    {
                      "text": "%page%",
                      "code": [
                        {
                          "variable": "page"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Value",
                  "type": {
                    "name": "item",
                    "template": "plang"
                  },
                  "value": "%!data%",
                  "variable": [
                    {
                      "text": "%!data%",
                      "code": [
                        {
                          "variable": "!data"
                        }
                      ]
                    }
                  ]
                }
              ],
              "default": [
                {
                  "name": "default",
                  "type": {
                    "name": "bool"
                  },
                  "value": false
                }
              ]
            }
          ],
          "waitForExecution": true
        },
        {
          "index": 1,
          "text": "save %page% to \"/modules/%module.Name%.md\"",
          "line": {
            "number": 13
          },
          "code": [
            {
              "module": "file",
              "name": "save",
              "property": [
                {
                  "name": "Path",
                  "type": {
                    "name": "path",
                    "template": "plang"
                  },
                  "value": "/modules/%module.Name%.md",
                  "variable": [
                    {
                      "text": "%module.Name%",
                      "code": [
                        {
                          "variable": "module"
                        },
                        {
                          "property": "Name"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Value",
                  "type": {
                    "name": "item",
                    "template": "plang"
                  },
                  "value": "%page%",
                  "variable": [
                    {
                      "text": "%page%",
                      "code": [
                        {
                          "variable": "page"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "waitForExecution": true
        },
        {
          "index": 2,
          "text": "foreach %module.Action%, call Unmatched action=%item%",
          "line": {
            "number": 14
          },
          "code": [
            {
              "module": "loop",
              "name": "foreach",
              "property": [
                {
                  "name": "Collection",
                  "type": {
                    "name": "item",
                    "template": "plang"
                  },
                  "value": "%module.Action%",
                  "variable": [
                    {
                      "text": "%module.Action%",
                      "code": [
