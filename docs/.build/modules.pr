                  "name": "item",
                  "type": {
                    "name": "variable"
                  },
                  "value": "%item%",
                  "variable": [
                    {
                      "text": "%item%",
                      "code": [
                        {
                          "variable": "item"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "module": "goal",
              "name": "call",
              "property": [
                {
                  "name": "Name",
                  "type": {
                    "name": "goal"
                  },
                  "value": "Unmatched"
                },
                {
                  "name": "Parameter",
                  "type": {
                    "name": "list"
                  },
                  "value": [{"name":"action","type":{"name":"item","template":"plang"},"value":"%item%","variable":[{"text":"%item%","code":[{"variable":"item"}]}]}]
                }
              ],
              "default": [
                {
                  "name": "parallel",
                  "type": {
                    "name": "bool"
                  },
                  "value": false
                }
              ]
            }
          ],
          "waitForExecution": true
        }
      ],
      "child": [],
      "visibility": "Private",
