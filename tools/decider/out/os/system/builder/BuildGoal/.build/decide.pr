 "child": [
  {
   "name": "AddStepToState",
   "path": "/os/system/builder/BuildGoal/Decide.goal",
   "step": [
    {
     "index": 0,
     "text": "add {\"index\": %step.Index%, \"text\": %step.Text%} to %state.steps%",
     "lineNumber": 36,
     "comment": "The decider sees a step as its position and its words \u2014 nothing it has been compiled into yet.",
     "waitForExecution": true,
     "action": [
      {
       "module": "list",
       "name": "add",
       "parameter": [
