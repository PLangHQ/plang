{
 "about": "Stage-3 golden set: five whole goals, one request each, scored per step. The menu per step is the right one (the decider is not under test): the step's OWN actions — an action held as a value (channel.set's Goal) or as a modifier's recovery is not on it. Expected answers written by hand. The earlier 32 one-step cases are in git history (0da24055e). A value {\"$oneOf\": [...]} accepts any of its alternatives; an expected value with \"module\" is an action (an action-typed property).",
 "cases": [
  {
   "id": "build",
   "covers": "the builder's entry goal (os/system/builder/Build.goal): set default, a channel with a callback goal (the goal.call is the value of Goal, not a pick of its own), calls with arguments, write to, foreach + call, file save, actions with no properties",
   "goal": "Build",
   "steps": [
    {"text": "set default %path% = \"/\"", "indent": 0,
     "comment": "Main entry point for the PLang builder\nTransforms .goal files (natural language) into .pr files (JSON the Runtime executes)\nParameters: %path% - folder to build (default: \".\")"},
    {"text": "set default %!build.cache% = true", "indent": 0},
    {"text": "set default %!build.summary% = true", "indent": 0},
    {"text": "set channel \"builder\" call BuilderChannel", "indent": 0},
    {"text": "call EmitBuildEvent kind=\"build-path\", path=%path%", "indent": 0},
    {"text": "build.load, write to %app%", "indent": 0},
    {"text": "build.goals path=%path%, write to %goals%", "indent": 0},
    {"text": "call EmitBuildEvent kind=\"goals-found\", goals=%goals%", "indent": 0},
    {"text": "foreach %goals%, call BuildGoal goal=%item%", "indent": 0},
    {"text": "save %traceGoals% to file '/.build/traces/%!trace.id%/manifest.json'", "indent": 0},
    {"text": "build.appSave", "indent": 0}
   ],
   "menu": {
    "0": ["variable.set"], "1": ["variable.set"], "2": ["variable.set"],
    "3": ["channel.set"],
    "4": ["goal.call"],
    "5": ["build.load", "variable.set"],
    "6": ["build.goals", "variable.set"],
    "7": ["goal.call"],
    "8": ["loop.foreach", "goal.call"],
    "9": ["file.save"],
    "10": ["build.appSave"]
   },
   "expect": {
    "0": [{"module": "variable", "name": "set", "property": {"Name": "%path%", "Value": "/", "AsDefault": true}}],
    "1": [{"module": "variable", "name": "set", "property": {"Name": "%!build.cache%", "Value": true, "AsDefault": true}}],
    "2": [{"module": "variable", "name": "set", "property": {"Name": "%!build.summary%", "Value": true, "AsDefault": true}}],
    "3": [{"module": "channel", "name": "set", "property": {"Name": "builder",
           "Goal": {"module": "goal", "name": "call", "property": {"Name": "BuilderChannel"}}}}],
    "4": [{"module": "goal", "name": "call", "property": {"Name": "EmitBuildEvent",
           "Parameter": [{"name": "kind", "value": "build-path"}, {"name": "path", "value": "%path%"}]}}],
    "5": [{"module": "build", "name": "load"},
          {"module": "variable", "name": "set", "property": {"Name": "%app%", "Value": "%!data%"}}],
    "6": [{"module": "build", "name": "goals", "property": {"Path": "%path%"}},
          {"module": "variable", "name": "set", "property": {"Name": "%goals%", "Value": "%!data%"}}],
    "7": [{"module": "goal", "name": "call", "property": {"Name": "EmitBuildEvent",
           "Parameter": [{"name": "kind", "value": "goals-found"}, {"name": "goals", "value": "%goals%"}]}}],
    "8": [{"module": "loop", "name": "foreach", "property": {"Collection": "%goals%"}},
          {"module": "goal", "name": "call", "property": {"Name": "BuildGoal", "Parameter": [{"name": "goal", "value": "%item%"}]}}],
    "9": [{"module": "file", "name": "save", "property": {"Path": "/.build/traces/%!trace.id%/manifest.json", "Value": "%traceGoals%"}}],
    "10": [{"module": "build", "name": "appSave"}]
   }
  },
  {
   "id": "start",
   "covers": "the builder's per-file goal (os/system/builder/BuildGoal/Start.goal, Start): on error call X (a modifier with recovery), a dict literal, foreach + call with an argument, math with named arguments + write to, file save, list add, a goal-typed property (Goal=%goal%), a goal.call held only as a recovery (not a pick of its own)",
   "goal": "Start",
   "steps": [
    {"text": "call /system/builder/EmitBuildEvent kind=\"goalHeader\", goal=%goal%", "indent": 0,
     "comment": "Build one .goal file: decide which modules and actions each step uses, then let the LLM order\nthem and fill their properties, then validate and recurse into sub-goals."},
    {"text": "set %buildStart% = %Now.Ticks%", "indent": 0},
    {"text": "set %trace% = {\"id\": \"%!trace.id%\", \"timestamp\": \"%Now%\", \"goal\": %goal%, \"menu\": null, \"subGoals\": [], \"durationMs\": 0}", "indent": 0},
    {"text": "call Compile, on error call HandleBuildFailure", "indent": 0},
    {"text": "set %trace.menu% = %menu%", "indent": 0},
    {"text": "set %parentGoal% = %goal%", "indent": 0},
    {"text": "foreach %parentGoal.Child%, call BuildSubGoal subGoal=%item%", "indent": 0},
    {"text": "set %goal% = %parentGoal%", "indent": 0},
    {"text": "math.subtract A=%Now.Ticks%, B=%buildStart%, write to %elapsedTicks%", "indent": 0},
    {"text": "math.divide A=%elapsedTicks%, B=10000, write to %elapsedMs%", "indent": 0},
    {"text": "set %trace.durationMs% = %elapsedMs%", "indent": 0},
    {"text": "save %trace% to file '/.build/traces/%!trace.id%/%goal.Name%.json'", "indent": 0},
    {"text": "add %goal.Name% to %traceGoals%", "indent": 0},
    {"text": "build.fold Goal=%goal%, on error call HandleBuildFailure", "indent": 0,
     "comment": "Re-parent indented sub-steps into the preceding condition's gate-action Child (recurses sub-goals). Post-compile, pre-save."},
    {"text": "build.goalsSave Goal=%goal%", "indent": 0}
   ],
   "menu": {
    "0": ["goal.call"], "1": ["variable.set"], "2": ["variable.set"],
    "3": ["goal.call", "error.handle"],
    "4": ["variable.set"], "5": ["variable.set"],
    "6": ["loop.foreach", "goal.call"],
    "7": ["variable.set"],
    "8": ["math.subtract", "variable.set"],
    "9": ["math.divide", "variable.set"],
    "10": ["variable.set"],
    "11": ["file.save"],
    "12": ["list.add"],
    "13": ["build.fold", "error.handle"],
    "14": ["build.goalsSave"]
   },
   "expect": {
    "0": [{"module": "goal", "name": "call", "property": {"Name": "/system/builder/EmitBuildEvent",
           "Parameter": [{"name": "kind", "value": "goalHeader"}, {"name": "goal", "value": "%goal%"}]}}],
    "1": [{"module": "variable", "name": "set", "property": {"Name": "%buildStart%", "Value": "%Now.Ticks%"}}],
    "2": [{"module": "variable", "name": "set", "property": {"Name": "%trace%", "Value": {"$oneOf": [
           "{\"id\": \"%!trace.id%\", \"timestamp\": \"%Now%\", \"goal\": %goal%, \"menu\": null, \"subGoals\": [], \"durationMs\": 0}",
           {"id": "%!trace.id%", "timestamp": "%Now%", "goal": "%goal%", "menu": null, "subGoals": [], "durationMs": 0}]}}}],
    "3": [{"module": "goal", "name": "call", "property": {"Name": "Compile"},
           "modifier": [{"module": "error", "name": "handle",
                         "recovery": [{"module": "goal", "name": "call", "property": {"Name": "HandleBuildFailure"}}]}]}],
    "4": [{"module": "variable", "name": "set", "property": {"Name": "%trace.menu%", "Value": "%menu%"}}],
    "5": [{"module": "variable", "name": "set", "property": {"Name": "%parentGoal%", "Value": "%goal%"}}],
    "6": [{"module": "loop", "name": "foreach", "property": {"Collection": "%parentGoal.Child%"}},
          {"module": "goal", "name": "call", "property": {"Name": "BuildSubGoal", "Parameter": [{"name": "subGoal", "value": "%item%"}]}}],
    "7": [{"module": "variable", "name": "set", "property": {"Name": "%goal%", "Value": "%parentGoal%"}}],
    "8": [{"module": "math", "name": "subtract", "property": {"A": "%Now.Ticks%", "B": "%buildStart%"}},
          {"module": "variable", "name": "set", "property": {"Name": "%elapsedTicks%", "Value": "%!data%"}}],
    "9": [{"module": "math", "name": "divide", "property": {"A": "%elapsedTicks%", "B": 10000}},
          {"module": "variable", "name": "set", "property": {"Name": "%elapsedMs%", "Value": "%!data%"}}],
    "10": [{"module": "variable", "name": "set", "property": {"Name": "%trace.durationMs%", "Value": "%elapsedMs%"}}],
    "11": [{"module": "file", "name": "save", "property": {"Path": "/.build/traces/%!trace.id%/%goal.Name%.json", "Value": "%trace%"}}],
    "12": [{"module": "list", "name": "add", "property": {"ListName": "%traceGoals%", "Value": "%goal.Name%"}}],
    "13": [{"module": "build", "name": "fold", "property": {"Goal": "%goal%"},
            "modifier": [{"module": "error", "name": "handle",
                          "recovery": [{"module": "goal", "name": "call", "property": {"Name": "HandleBuildFailure"}}]}]}],
    "14": [{"module": "build", "name": "goalsSave", "property": {"Goal": "%goal%"}}]
   }
  },
  {
   "id": "decide",
   "covers": "the builder's decider goal (os/system/builder/BuildGoal/Decide.goal, Decide): a number, an infra variable, foreach + call passing item=, render template + write to, llm.decider with named arguments + write to (its Model default)",
   "goal": "Decide",
   "steps": [
    {"text": "set %threshold% = 0.5", "indent": 0,
     "comment": "Decide which module and which action every step of this goal uses — the whole goal in two\nexchanges, not one LLM call per step."},
    {"text": "set %modules% = %!app.module.list%", "indent": 0},
    {"text": "set %state.goal% = %goal.Name%", "indent": 0},
    {"text": "foreach %goal.Step%, call AddStepToState step=%item%", "indent": 0},
    {"text": "foreach %modules%, call AddModuleToState module=%item%", "indent": 0},
    {"text": "render template \"/system/builder/llm/templates/deciderModuleQuestions.template\", write to %moduleQuestions%", "indent": 0},
    {"text": "llm.decider State=%state%, Question=%moduleQuestions%, write to %moduleAnswer%", "indent": 0},
    {"text": "render template \"/system/builder/llm/templates/deciderActionQuestions.template\", write to %actionQuestions%", "indent": 0},
    {"text": "llm.decider State=%state%, Question=%actionQuestions%, write to %actionAnswer%", "indent": 0},
    {"text": "call /system/builder/EmitBuildEvent kind=\"goal-decided\", goal=%goal%", "indent": 0}
   ],
   "menu": {
    "0": ["variable.set"], "1": ["variable.set"], "2": ["variable.set"],
    "3": ["loop.foreach", "goal.call"], "4": ["loop.foreach", "goal.call"],
    "5": ["ui.render", "variable.set"], "6": ["llm.decider", "variable.set"],
    "7": ["ui.render", "variable.set"], "8": ["llm.decider", "variable.set"],
    "9": ["goal.call"]
   },
   "expect": {
    "0": [{"module": "variable", "name": "set", "property": {"Name": "%threshold%", "Value": 0.5}}],
    "1": [{"module": "variable", "name": "set", "property": {"Name": "%modules%", "Value": "%!app.module.list%"}}],
    "2": [{"module": "variable", "name": "set", "property": {"Name": "%state.goal%", "Value": "%goal.Name%"}}],
    "3": [{"module": "loop", "name": "foreach", "property": {"Collection": "%goal.Step%"}},
          {"module": "goal", "name": "call", "property": {"Name": "AddStepToState", "Parameter": [{"name": "step", "value": "%item%"}]}}],
    "4": [{"module": "loop", "name": "foreach", "property": {"Collection": "%modules%"}},
          {"module": "goal", "name": "call", "property": {"Name": "AddModuleToState", "Parameter": [{"name": "module", "value": "%item%"}]}}],
    "5": [{"module": "ui", "name": "render", "property": {"Template": "/system/builder/llm/templates/deciderModuleQuestions.template"}},
          {"module": "variable", "name": "set", "property": {"Name": "%moduleQuestions%", "Value": "%!data%"}}],
    "6": [{"module": "llm", "name": "decider", "property": {"State": "%state%", "Question": "%moduleQuestions%"}},
          {"module": "variable", "name": "set", "property": {"Name": "%moduleAnswer%", "Value": "%!data%"}}],
    "7": [{"module": "ui", "name": "render", "property": {"Template": "/system/builder/llm/templates/deciderActionQuestions.template"}},
          {"module": "variable", "name": "set", "property": {"Name": "%actionQuestions%", "Value": "%!data%"}}],
    "8": [{"module": "llm", "name": "decider", "property": {"State": "%state%", "Question": "%actionQuestions%"}},
          {"module": "variable", "name": "set", "property": {"Name": "%actionAnswer%", "Value": "%!data%"}}],
    "9": [{"module": "goal", "name": "call", "property": {"Name": "/system/builder/EmitBuildEvent",
           "Parameter": [{"name": "kind", "value": "goal-decided"}, {"name": "goal", "value": "%goal%"}]}}]
   }
  },
  {
   "id": "checkout",
   "covers": "inline conditions: if / else if / else in one line, `is 0` / `is 1` (a value → ==), `is not a number` (isnot + a type), `does not contain` / `is not empty` / `does not start with` (the negative operators), `is \"IS\"` + else setting a variable, a call with two arguments in a branch, write to, math with named arguments, a step with no condition",
   "goal": "Checkout",
   "steps": [
    {"text": "read 'orders/%orderId%.json', write to %order%", "indent": 0,
     "comment": "Price one order and tell the customer what it costs."},
    {"text": "count %order.items%, write to %itemCount%", "indent": 0},
    {"text": "if %itemCount% is 0, write out \"Your cart is empty\", else if %itemCount% is 1, write out \"One item\", else write out \"%itemCount% items\"", "indent": 0},
    {"text": "if %order.email% does not contain \"@\", throw \"Invalid email address\"", "indent": 0},
    {"text": "if %order.coupon% is not empty, call ApplyCoupon code=%order.coupon%, order=%order%", "indent": 0},
    {"text": "if %order.total% is not a number, throw \"The total must be a number\"", "indent": 0},
    {"text": "if %order.country% is \"IS\", set %vat% = 0.24, else set %vat% = 0.25", "indent": 0},
    {"text": "math.multiply A=%order.total%, B=%vat%, write to %vatAmount%", "indent": 0},
    {"text": "if %order.note% does not start with \"#\", add %order.note% to %notes%", "indent": 0},
    {"text": "write out \"Total: %order.total%, VAT: %vatAmount%\"", "indent": 0}
   ],
   "menu": {
    "0": ["file.read", "variable.set"],
    "1": ["list.count", "variable.set"],
    "2": ["condition.if", "condition.elseif", "condition.else", "output.write"],
    "3": ["condition.if", "error.throw"],
    "4": ["condition.if", "goal.call"],
    "5": ["condition.if", "error.throw"],
    "6": ["condition.if", "condition.else", "variable.set"],
    "7": ["math.multiply", "variable.set"],
    "8": ["condition.if", "list.add"],
    "9": ["output.write"]
   },
   "expect": {
    "0": [{"module": "file", "name": "read", "property": {"Path": "orders/%orderId%.json"}},
          {"module": "variable", "name": "set", "property": {"Name": "%order%", "Value": "%!data%"}}],
    "1": [{"module": "list", "name": "count", "property": {"ListName": "%order.items%"}},
          {"module": "variable", "name": "set", "property": {"Name": "%itemCount%", "Value": "%!data%"}}],
    "2": [{"module": "condition", "name": "if", "property": {"Left": "%itemCount%", "Operator": "==", "Right": 0},
           "child": [{"text": "write out \"Your cart is empty\"", "action": [{"module": "output", "name": "write", "property": {"Data": "Your cart is empty"}}]}]},
          {"module": "condition", "name": "elseif", "property": {"Left": "%itemCount%", "Operator": "==", "Right": 1},
           "child": [{"text": "write out \"One item\"", "action": [{"module": "output", "name": "write", "property": {"Data": "One item"}}]}]},
          {"module": "condition", "name": "else",
           "child": [{"text": "write out \"%itemCount% items\"", "action": [{"module": "output", "name": "write", "property": {"Data": "%itemCount% items"}}]}]}],
    "3": [{"module": "condition", "name": "if", "property": {"Left": "%order.email%", "Operator": "notcontains", "Right": "@"},
           "child": [{"text": "throw \"Invalid email address\"", "action": [{"module": "error", "name": "throw", "property": {"Message": "Invalid email address"}}]}]}],
    "4": [{"module": "condition", "name": "if", "property": {"Left": "%order.coupon%", "Operator": "isnotempty"},
           "child": [{"text": "call ApplyCoupon code=%order.coupon%, order=%order%", "action": [{"module": "goal", "name": "call", "property": {"Name": "ApplyCoupon",
                      "Parameter": [{"name": "code", "value": "%order.coupon%"}, {"name": "order", "value": "%order%"}]}}]}]}],
    "5": [{"module": "condition", "name": "if", "property": {"Left": "%order.total%", "Operator": "isnot", "Right": "number"},
           "child": [{"text": "throw \"The total must be a number\"", "action": [{"module": "error", "name": "throw", "property": {"Message": "The total must be a number"}}]}]}],
    "6": [{"module": "condition", "name": "if", "property": {"Left": "%order.country%", "Operator": "==", "Right": "IS"},
           "child": [{"text": "set %vat% = 0.24", "action": [{"module": "variable", "name": "set", "property": {"Name": "%vat%", "Value": 0.24}}]}]},
          {"module": "condition", "name": "else",
           "child": [{"text": "set %vat% = 0.25", "action": [{"module": "variable", "name": "set", "property": {"Name": "%vat%", "Value": 0.25}}]}]}],
    "7": [{"module": "math", "name": "multiply", "property": {"A": "%order.total%", "B": "%vat%"}},
          {"module": "variable", "name": "set", "property": {"Name": "%vatAmount%", "Value": "%!data%"}}],
    "8": [{"module": "condition", "name": "if", "property": {"Left": "%order.note%", "Operator": "notstartswith", "Right": "#"},
           "child": [{"text": "add %order.note% to %notes%", "action": [{"module": "list", "name": "add", "property": {"ListName": "%notes%", "Value": "%order.note%"}}]}]}],
    "9": [{"module": "output", "name": "write", "property": {"Data": "Total: %order.total%, VAT: %vatAmount%"}}]
   }
  },
  {
   "id": "weekly_report",
   "covers": "indented bodies (a condition with no inline body, the steps under it separate entries), `is empty` (unary), `is a list` (is + a type), an empty list literal, foreach + call with an argument, file list with a named option + write to, render with a template argument + write to, a call with arguments and on error call X, output to a named channel, steps with no condition",
   "goal": "WeeklyReport",
   "steps": [
    {"text": "list files in '/logs', pattern \"*.log\", write to %files%", "indent": 0,
     "comment": "Collect the week's errors from the log files and send the report."},
    {"text": "set %errors% = []", "indent": 0},
    {"text": "foreach %files%, call ScanFile file=%item%", "indent": 0},
    {"text": "if %errors% is empty", "indent": 0},
    {"text": "write out \"No errors this week\"", "indent": 1},
    {"text": "return", "indent": 1},
    {"text": "if %files% is a list", "indent": 0},
    {"text": "write out \"Scanned the log files\"", "indent": 1},
    {"text": "render template \"report.html\", errors=%errors%, write to %html%", "indent": 0},
    {"text": "save %html% to file '/reports/week.html'", "indent": 0},
    {"text": "call SendReport to=\"ops@example.com\", subject=\"Weekly report\", on error call LogFailure", "indent": 0},
    {"text": "write out \"Report sent\" to \"log\" channel", "indent": 0}
   ],
   "menu": {
    "0": ["file.list", "variable.set"],
    "1": ["variable.set"],
    "2": ["loop.foreach", "goal.call"],
    "3": ["condition.if"],
    "4": ["output.write"],
    "5": ["goal.return"],
    "6": ["condition.if"],
    "7": ["output.write"],
    "8": ["ui.render", "variable.set"],
    "9": ["file.save"],
    "10": ["goal.call", "error.handle"],
    "11": ["output.write"]
   },
   "expect": {
    "0": [{"module": "file", "name": "list", "property": {"Path": "/logs", "Pattern": "*.log"}},
          {"module": "variable", "name": "set", "property": {"Name": "%files%", "Value": "%!data%"}}],
    "1": [{"module": "variable", "name": "set", "property": {"Name": "%errors%", "Value": []}}],
    "2": [{"module": "loop", "name": "foreach", "property": {"Collection": "%files%"}},
          {"module": "goal", "name": "call", "property": {"Name": "ScanFile", "Parameter": [{"name": "file", "value": "%item%"}]}}],
    "3": [{"module": "condition", "name": "if", "property": {"Left": "%errors%", "Operator": "isempty"}}],
    "4": [{"module": "output", "name": "write", "property": {"Data": "No errors this week"}}],
    "5": [{"module": "goal", "name": "return"}],
    "6": [{"module": "condition", "name": "if", "property": {"Left": "%files%", "Operator": "is", "Right": "list"}}],
    "7": [{"module": "output", "name": "write", "property": {"Data": "Scanned the log files"}}],
    "8": [{"module": "ui", "name": "render", "property": {"Template": "report.html", "Parameter": [{"name": "errors", "value": "%errors%"}]}},
          {"module": "variable", "name": "set", "property": {"Name": "%html%", "Value": "%!data%"}}],
    "9": [{"module": "file", "name": "save", "property": {"Path": "/reports/week.html", "Value": "%html%"}}],
    "10": [{"module": "goal", "name": "call", "property": {"Name": "SendReport",
             "Parameter": [{"name": "to", "value": "ops@example.com"}, {"name": "subject", "value": "Weekly report"}]},
            "modifier": [{"module": "error", "name": "handle",
                          "recovery": [{"module": "goal", "name": "call", "property": {"Name": "LogFailure"}}]}]}],
    "11": [{"module": "output", "name": "write", "property": {"Data": "Report sent", "channel": "log"}}]
   }
  }
 ]
