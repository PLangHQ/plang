/ A value packed into an archive unpacks back to itself, losslessly.
Start
- set %original% = 'The quick brown fox jumps over the lazy dog.', type=text/plain
- pack %original%, write to %archived%
- assert %archived!type.name% equals 'archive'
- unpack %archived%, write to %restored%
- assert %restored% equals 'The quick brown fox jumps over the lazy dog.'
