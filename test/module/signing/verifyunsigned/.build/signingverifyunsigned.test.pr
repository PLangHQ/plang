{
  "name": "Start",
  "comment": "Test: verify data that was never signed",
  "step": [
    {
      "index": 0,
      "text": "set %data% = { \"payload\": \"unsigned\" }",
      "line": {
        "number": 3
      },
      "code": [
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%data%",
              "variable": [
                {
                  "text": "%data%",
                  "code": [
                    {
                      "variable": "data"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "dict"
              },
              "value": {"payload":"unsigned"}
