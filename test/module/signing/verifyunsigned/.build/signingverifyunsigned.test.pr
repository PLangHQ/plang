              "name": "default",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "verify %data% with contracts ['C0'], on error call HandleNoSig",
      "line": {
        "number": 4
      },
      "code": [
        {
          "module": "signing",
          "name": "verify",
          "property": [
            {
              "name": "Data",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%data%",
              "variable": [
                {
                  "text": "%data%",
                  "code": [
                    {
                      "variable": "data"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Contracts",
              "type": {
                "name": "list"
              },
              "value": ["C0"]
            }
          ]
        },
        {
          "module": "on",
          "name": "error",
          "property": [
            {
              "name": "Recovery",
              "type": {
                "name": "list",
                "kind": "action"
              },
              "value": [
                {
                  "module": "goal",
                  "name": "call",
                  "property": [
                    {
                      "name": "Name",
                      "type": {
                        "name": "goal"
                      },
                      "value": "HandleNoSig"
