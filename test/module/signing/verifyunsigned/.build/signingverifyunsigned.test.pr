                  ]
                }
              ]
            }
          ],
          "default": [
            {
              "name": "ignore",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {
      "index": 2,
      "text": "assert %noSig% is true, \"verify unsigned data should fail\"",
      "line": {
        "number": 5
      },
      "code": [
        {
          "module": "assert",
          "name": "isTrue",
          "property": [
            {
              "name": "Value",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%noSig%",
              "variable": [
                {
                  "text": "%noSig%",
                  "code": [
                    {
                      "variable": "noSig"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Message",
              "type": {
                "name": "text"
              },
              "value": "verify unsigned data should fail"
