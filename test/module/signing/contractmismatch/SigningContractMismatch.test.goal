/ Test: verify with wrong contracts fails — as a contract mismatch, not as any other refusal
Start
- set %data% = { "payload": "test" }
- sign %data% with contracts ['C0'], write to %signed%
- verify %signed% with contracts ['C1'], on error call HandleContractError
- assert %errorKey% equals "ContractMismatch", "contract mismatch should fail verification"

HandleContractError
- set %errorKey% = %!error.Key%
