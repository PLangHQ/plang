/ The signature covers the Data whole — its properties too: a property added to the signed
/ value after signing fails verify as a hash mismatch, not as any other refusal.
Start
- set %data% = { "message": "as signed" }
- sign %data%, write to %signed%
- set %signed!note% = "added after signing"
- verify %signed%, on error call HandleTampered
- assert %errorKey% equals "DataHashMismatch", "a property added after signing should fail verification"

HandleTampered
- set %errorKey% = %!error.Key%
