/ Test: verify fails when expected headers don't match signed headers — as a header mismatch,
/ not as any other refusal
Start
- archive identity 'testSigner', force, on error ignore
- create identity testSigner
- set %data% = { "body": "content" }
- set %signHeaders% = { "method": "POST", "url": "/api/send" }
- sign %data% with headers %signHeaders%, write to %signed%
- set %wrongHeaders% = { "method": "GET", "url": "/api/send" }
- verify %signed% with contracts ['C0'] and headers %wrongHeaders%, on error call HandleHeaderError
- assert %errorKey% equals "HeaderMismatch", "header mismatch should fail verification"

HandleHeaderError
- set %errorKey% = %!error.Key%
