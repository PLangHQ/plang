              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {
      "index": 4,
      "text": "wait for 60 ms",
      "line": {
        "number": 7,
        "indent": 0
      },
      "code": [
        {
          "module": "timer",
          "name": "sleep",
          "property": [
