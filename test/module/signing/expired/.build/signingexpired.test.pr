{
  "name": "Start",
  "comment": "Test: sign with short TTL, wait, verify fails as expired — not as any other refusal",
  "step": [
    {
      "index": 0,
      "text": "archive identity 'testSigner', force, on error ignore",
      "line": {
        "number": 3,
        "indent": 0
      },
      "code": [
        {
          "module": "identity",
          "name": "archive",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "text"
              },
              "value": "testSigner"
            },
            {
              "name": "Force",
              "type": {
                "name": "bool"
              },
              "value": true
            }
          ]
        },
        {
          "module": "on",
          "name": "error",
          "property": [
            {
              "name": "Ignore",
              "type": {
                "name": "bool"
              },
              "value": true
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "create identity testSigner",
      "line": {
        "number": 4,
        "indent": 0
      },
      "code": [
        {
          "module": "identity",
          "name": "create",
          "property": [
