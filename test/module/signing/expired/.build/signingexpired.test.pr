                      "variable": "data"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Expires",
              "type": {
                "name": "duration"
              },
              "value": "50ms"
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%signed%",
              "variable": [
