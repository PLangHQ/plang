    },
    {
      "index": 3,
      "text": "sign %data%, expires in 50 ms, write to %signed%",
      "line": {
        "number": 6,
        "indent": 0
      },
      "code": [
        {
          "module": "signing",
          "name": "sign",
          "property": [
