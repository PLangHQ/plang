{
  "name": "Start",
  "comment": "\"if <file> exists\" must ask file.exists and branch on ITS result, not test whatever the previous step\nleft in %!data%. A data-leaving step first makes %!data% truthy, so the old shape\n(condition.if(Left=%!data%)) would fire for a missing file too. An existing file must fire, a missing one\nmust not — the missing-file branch is the discriminator.",
  "step": [
    {
      "index": 0,
      "text": "write out \"something before\"",
      "line": {
        "number": 6
      },
