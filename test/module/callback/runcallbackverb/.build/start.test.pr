{
  "name": "Start",
  "comment": "Fix, then go on from the same step: Work's first step throws while 'workspace/broken' exists. Its handler fixes the\ncause (deletes the file), then starts the error's callback, which goes on from the step that threw, in an app of its\nown: the step runs again, no longer throws, and that run goes on to its end, through this goal too, answering\n\"completed\". The callback is the run as it stood at the throw, so %resumed% is set only here, in the asker.",
  "step": [
    {
      "index": 0,
      "text": "write \"broken\" to file 'workspace/broken'",
      "line": {
        "number": 6,
        "indent": 0
      },
      "code": [
        {
          "module": "file",
          "name": "save",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "workspace/broken"
            },
            {
              "name": "Value",
              "type": {
                "name": "text"
              },
              "value": "broken"
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "call Work",
      "line": {
        "number": 7,
        "indent": 0
      },
      "code": [
        {
          "module": "goal",
          "name": "call",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "goal"
              },
              "value": "Work"
            }
          ]
        }
      ]
    },
    {
      "index": 2,
      "text": "if %resumed% is not empty",
      "line": {
        "number": 8,
        "indent": 0
      },
      "code": [
        {
          "module": "condition",
          "name": "if",
          "property": [
            {
              "name": "Left",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%resumed%",
              "variable": [
                {
                  "text": "%resumed%",
                  "code": [
                    {
                      "variable": "resumed"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Operator",
              "type": {
                "name": "choice",
                "kind": "operator"
              },
              "value": "isnotempty"
            }
          ],
          "child": [
            {
              "index": 3,
              "text": "assert %resumed% equals \"completed\", \"the callback's run should have gone on to its end\"",
              "line": {
                "number": 9,
                "indent": 1
              },
              "code": [
                {
                  "module": "assert",
                  "name": "equals",
                  "property": [
                    {
                      "name": "Expected",
                      "type": {
                        "name": "text"
                      },
                      "value": "completed"
                    },
                    {
                      "name": "Actual",
                      "type": {
                        "name": "item",
                        "template": "plang"
                      },
                      "value": "%resumed%",
                      "variable": [
                        {
                          "text": "%resumed%",
                          "code": [
                            {
                              "variable": "resumed"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "Message",
                      "type": {
                        "name": "text"
                      },
                      "value": "the callback's run should have gone on to its end"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "index": 4,
      "text": "return \"completed\"",
      "line": {
        "number": 10,
        "indent": 0
      },
