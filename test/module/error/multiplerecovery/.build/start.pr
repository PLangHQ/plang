              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "fallback.txt"
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%content%",
              "variable": [
                {
                  "text": "%content%",
                  "code": [
                    {
                      "variable": "content"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
