{
  "name": "Start",
  "comment": "Multiple nested recovery actions — the case that was breaking last session.\nThe on.error.Actions list must carry three nested action records:\noutput.write, file.read (with [path] type), variable.set.\nThis is the shape last session's LLM kept mangling.",
  "step": [
    {
      "index": 0,
      "text": "read 'data.txt', on error 404, write out \"primary missing\", read 'fallback.txt', write to %content%",
      "line": {
        "number": 7
      },
      "code": [
        {
          "module": "file",
          "name": "read",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "data.txt"
            }
          ]
        },
        {
          "module": "on",
          "name": "error",
          "property": [
            {
              "name": "Status",
              "type": {
                "name": "status"
              },
              "value": 404
            },
            {
              "name": "Recovery",
              "type": {
                "name": "list",
                "kind": "action"
              },
              "value": [
                {
                  "module": "output",
                  "name": "write",
                  "property": [
                    {
                      "name": "Data",
                      "type": {
                        "name": "text"
                      },
                      "value": "primary missing"
                    }
                  ]
                }
              ]
            }
          ],
          "default": [
            {
              "name": "ignore",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        },
        {
          "module": "file",
          "name": "read",
          "property": [
