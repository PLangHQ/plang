{
  "name": "Start",
  "comment": "Multi-step goal where only one step has error handling.\nVerifies the modifier attaches to the right action and doesn't bleed into peer steps.",
  "step": [
    {
      "index": 0,
      "text": "read 'config.json', on error 404, write out \"no config\"",
      "line": {
        "number": 5
      },
      "code": [
        {
          "module": "file",
          "name": "read",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "config.json"
            }
          ]
        },
        {
          "module": "on",
          "name": "error",
          "property": [
            {
              "name": "Status",
              "type": {
                "name": "status"
              },
              "value": 404
            },
            {
              "name": "Recovery",
              "type": {
                "name": "list",
                "kind": "action"
              },
              "value": [
                {
                  "module": "output",
                  "name": "write",
                  "property": [
                    {
                      "name": "Data",
                      "type": {
                        "name": "text"
                      },
                      "value": "no config"
                    }
                  ]
                }
              ]
            }
          ],
          "default": [
            {
              "name": "ignore",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "read 'data.txt', write to %content%",
      "line": {
        "number": 6
      },
      "code": [
        {
          "module": "file",
          "name": "read",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "data.txt"
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%content%",
              "variable": [
                {
                  "text": "%content%",
                  "code": [
                    {
                      "variable": "content"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%!data%",
              "variable": [
                {
                  "text": "%!data%",
                  "code": [
                    {
                      "variable": "!data"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Type",
              "type": {
                "name": "type"
              },
              "value": {
                "name": "file"
              }
            }
          ],
          "default": [
            {
              "name": "default",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {
      "index": 2,
      "text": "write out %content%",
      "line": {
        "number": 7
      },
      "code": [
        {
          "module": "output",
          "name": "write",
          "property": [
            {
              "name": "Data",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%content%",
              "variable": [
                {
                  "text": "%content%",
                  "code": [
                    {
                      "variable": "content"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
