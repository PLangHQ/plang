{
  "name": "TestReportMasksSensitiveVariables",
  "comment": "Regression test for security finding #3: proves test.report routes assertion\nfailure content through DiagnosticOutput so [Sensitive] properties are masked.\nThe fixture fails with an Identity (carrying a Sensitive PrivateKey) in\nAssertionError.Actual + the Variables snapshot. We then check the written\nreport content has the key name preserved ('privateKey') but the value\nredacted ('******'), while the non-sensitive 'publicKey' still serializes.\nA regression that drops the DiagnosticOutput modifier — or falls back to\nvalue.ToString() — would fail the '******' assertion.",
  "step": [
    {
      "index": 0,
      "text": "test.discover tests in '_fixtures_sensitive', pattern='*.fixture.goal', recursive, write to %tests%",
      "line": {
        "number": 10
      },
      "code": [
        {
          "module": "test",
          "name": "discover",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "_fixtures_sensitive"
            },
            {
              "name": "Pattern",
              "type": {
                "name": "text"
              },
              "value": "*.fixture.goal"
            }
          ],
          "default": [
            {
              "name": "subfolder",
              "type": {
                "name": "choice",
                "kind": "subfolder"
              },
              "value": "include"
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%tests%",
              "variable": [
                {
                  "text": "%tests%",
                  "code": [
                    {
                      "variable": "tests"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%!data%",
              "variable": [
                {
                  "text": "%!data%",
                  "code": [
                    {
                      "variable": "!data"
                    }
                  ]
                }
              ]
            }
          ],
          "default": [
