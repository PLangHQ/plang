{
  "name": "Start",
  "comment": "When a later action in the step reads the query's result by member (%!data.count%), the result is taken,\nso NO write-back is appended and %people% is left unchanged. The consumed check asks the value's parsed\nvariables (root %!data%), so a member read (%!data.count%) or an index read (%!data[0]%) counts, where a\nsubstring test on a bare \"%!data%\" would miss it. Written in formal to fix the action order.",
  "step": [
    {
      "index": 0,
      "text": "set %people% = [{name: \"a\", age: 40}, {name: \"b\", age: 18}]",
      "line": {
        "number": 6
      },
      "code": [
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%people%",
              "variable": [
                {
                  "text": "%people%",
                  "code": [
                    {
                      "variable": "people"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "list"
              },
              "value": [{"name":"a","age":40},{"name":"b","age":18}]
            }
          ],
          "default": [
            {
              "name": "default",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 1,
      "text": "list.query(List=%people%, Query={order: \"age\"}); output.write(Data=\"%!data.count%\")",
      "line": {
        "number": 7
      },
      "code": [
        {
          "module": "list",
          "name": "query",
          "property": [
            {
