{
  "name": "Start",
  "comment": "A multi-part sentence, in words, builds to one list.query with where-and, group, distinct and order.",
  "step": [
    {
      "index": 0,
      "text": "set %users% = [{name: \"x\", city: \"A\", age: 30, active: true}, {name: \"y\", city: \"A\", age: 20, active: true}, {name: \"z\", city: \"B\", age: 40, active: false}]",
