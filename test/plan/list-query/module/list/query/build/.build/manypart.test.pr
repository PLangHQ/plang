    {
      "index": 1,
      "text": "filter %users% where active is true and age >= 18, group by city, distinct, order by age, write to %r%",
      "line": {
        "number": 4
      },
      "code": [
        {
          "module": "list",
          "name": "query",
          "property": [
            {
              "name": "List",
              "type": {
