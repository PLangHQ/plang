                      "variable": "users"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Query",
              "type": {
                "name": "query"
              },
              "value": {"where":{"and":[{"field":"active","op":"==","value":true},{"field":"age","op":">=","value":18}]},"group":"city","distinct":true,"order":"age"}
            }
