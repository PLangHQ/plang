              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 1,
      "text": "list.where %users% where agee > 20, write to %old%, on error key \"FieldNotFound\" call Caught",
