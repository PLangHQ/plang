{
  "name": "Start",
  "comment": "A where on a field no item has is a misspelling: an error with its own key, naming the field — never a\nsilently empty list.",
  "step": [
    {
      "index": 0,
      "text": "set %users% = [{\"name\": \"a\", \"age\": 30}, {\"name\": \"b\", \"age\": 10}]",
      "line": {
        "number": 4
      },
      "code": [
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
