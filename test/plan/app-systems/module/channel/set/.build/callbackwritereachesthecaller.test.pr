                    "name": "parallel",
                    "type": {
                      "name": "bool"
                    },
                    "value": false
                  }
                ]
              }
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 1,
      "text": "write \"hello\" to \"log\" channel",
