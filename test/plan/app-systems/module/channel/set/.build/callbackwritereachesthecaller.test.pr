{
  "name": "Start",
  "comment": "A goal channel calls back into a goal for each message: its writes reach the writer, while %message% ends\nwith the callback.",
  "step": [
    {
      "index": 0,
      "text": "set channel \"log\" call Log",
      "line": {
        "number": 4
      },
      "code": [
        {
          "module": "channel",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "text"
              },
              "value": "log"
            },
            {
              "name": "Goal",
              "type": {
                "name": "action"
              },
              "value": {
                "module": "goal",
                "name": "call",
                "property": [
                  {
                    "name": "Name",
                    "type": {
                      "name": "text"
                    },
                    "value": "Log"
                  }
                ],
                "default": [
