              ]
            },
            {
              "name": "Message",
              "type": {
                "name": "text"
              },
              "value": "the callback's write reaches the caller"
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 3,
      "text": "assert %message% is null, \"the message ends with the callback\"",
      "line": {
        "number": 7
      },
      "code": [
        {
          "module": "assert",
          "name": "isNull",
          "property": [
