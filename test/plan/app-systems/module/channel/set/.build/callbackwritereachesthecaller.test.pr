              },
              "value": "log"
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 2,
      "text": "assert %logged% equals \"hello\", \"the callback's write reaches the caller\"",
      "line": {
        "number": 6
      },
      "code": [
        {
          "module": "assert",
          "name": "equals",
          "property": [
            {
