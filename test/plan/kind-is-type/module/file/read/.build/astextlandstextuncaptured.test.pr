{
  "name": "AsTextLandsTextUncaptured",
  "comment": "file.read with a Type lands that type itself (decision 831): `read notes.md as text` births the\ncontent as a text, not a {file, md} reference. No `write to` here, so no capturing variable.set\ncan convert what the read landed — the read's own answer (%!data%) is what is checked.\nAsTextKeepsText can't see this: its capture carries Type=text and converts a file reference too.",
  "step": [
    {
      "index": 0,
      "text": "read notes.md as text",
      "line": {
        "number": 6
      },
      "code": [
        {
          "module": "file",
          "name": "read",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "notes.md"
            },
            {
              "name": "Type",
              "type": {
                "name": "type"
              },
              "value": "text"
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "assert.equals(Expected=\"text\", Actual=%!data!type.name%, Message=\"the read itself lands a text, not a file reference\")",
      "line": {
        "number": 7
      },
