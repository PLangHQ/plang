{
  "name": "ReadIntoIsATable",
  "comment": "A csv file reads into a plang table through its own type (ruling 5). The read goes\nfirst — the format type keeps its raw bytes until first use (ruling 6), so `is table`\nmust only be checked after a member read. report.csv has `name,count` + two rows;\n`%r.count%` reads 2 as the row count. Guard: green today (csv already parses to a\nplang table); stage 3 must keep it green.",
  "step": [
    {
      "index": 0,
      "text": "read report.csv, write to %r%",
      "line": {
        "number": 7
      },
      "code": [
        {
          "module": "file",
          "name": "read",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path"
              },
              "value": "report.csv"
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%r%",
              "variable": [
                {
                  "text": "%r%",
                  "code": [
                    {
                      "variable": "r"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
