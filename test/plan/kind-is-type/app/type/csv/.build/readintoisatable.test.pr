              "value": "the first read gives two rows through the csv type"
            }
          ]
        }
      ]
    },
    {
      "index": 2,
      "text": "condition.if(Left=%r%, Operator=\"is\", Right=\"table\") { variable.set(Name=%isTable%, Value=true) }",
