{
  "name": "ProbeAnswerer",
  "comment": "Channel-input answerer. Saves the question to an IN-root file (no Authorize\nprompt would fire on this path) for inspection, then returns \"a\". Writing\nto //tmp here would recurse into Authorize → output.ask → stdin EOF.",
  "step": [
    {
      "index": 0,
      "text": "file.save %message% to probe-question.txt",
      "line": {
        "number": 5
      },
      "code": [
