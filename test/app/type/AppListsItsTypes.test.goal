/ Stage 10a: %!app.type.list% is every type a program can use — the built-ins and the concepts alike.
Start
- set %types% = %!app.type.list%
- any %types% where "name" == "text", write to %hasText%
- assert %hasText% is true, "a built-in type is one of the app's"
- any %types% where "name" == "goal", write to %hasGoal%
- assert %hasGoal% is true, "a concept is a type too"
