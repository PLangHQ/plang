{
  "name": "BareLiteralJudgedByForm",
  "comment": "PLang is an intent language: a quoted literal in a standard form is typed by that form, no `as`\nneeded. \"2026-01-01\" births a date, \"PT30S\" a duration; any other quoted text, a version-like\nlabel under %version% among them, stays text. `as` is only a force.",
  "step": [
    {
      "index": 0,
      "text": "set %birthday% = \"2026-01-01\"",
