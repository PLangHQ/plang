{
  "name": "TestHandledFlagFalseWhenRecoveryFails",
  "comment": "When the recovery body itself throws, on.error.Wrap leaves Handled=false on the inner Call and re-throws — the original error propagates (with the recovery error chained) and the outer handler catches it. Side-effect proof: %outerCaught% gets set by the outer handler, which only fires if the inner recovery failed and re-threw.",
  "step": [
    {
      "index": 0,
      "text": "call InnerWithFailingRecovery, on error set %outerCaught% = true",
      "line": {
        "number": 3
      },
      "code": [
        {
          "module": "goal",
          "name": "call",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "goal"
              },
              "value": "InnerWithFailingRecovery"
            }
          ]
        },
        {
          "module": "on",
          "name": "error",
          "property": [
            {
              "name": "Recovery",
              "type": {
                "name": "list",
                "kind": "action"
              },
              "value": [
                {
                  "module": "variable",
                  "name": "set",
                  "property": [
                    {
                      "name": "Name",
                      "type": {
                        "name": "variable"
                      },
                      "value": "%outerCaught%",
                      "variable": [
                        {
                          "text": "%outerCaught%",
                          "code": [
                            {
                              "variable": "outerCaught"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "Value",
                      "type": {
                        "name": "bool"
                      },
                      "value": true
                    }
                  ],
                  "default": [
                    {
                      "name": "default",
                      "type": {
                        "name": "bool"
                      },
                      "value": false
                    }
                  ]
                }
              ]
            }
          ],
          "default": [
            {
              "name": "ignore",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "assert %outerCaught% is true, \"outer handler should have caught — recovery body must have re-thrown\"",
      "line": {
        "number": 4
      },
      "code": [
        {
          "module": "assert",
          "name": "isTrue",
          "property": [
            {
              "name": "Value",
