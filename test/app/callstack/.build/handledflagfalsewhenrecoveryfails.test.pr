              ]
            },
            {
              "name": "Message",
              "type": {
                "name": "text"
              },
              "value": "outer handler should have caught — recovery body must have re-thrown"
            }
          ]
        }
      ]
    }
  ],
  "child": [
    {
      "name": "InnerWithFailingRecovery",
      "comment": "Throws \"boom\", whose recovery body itself throws \"recovery-failed\". The outer-most on-error in the test goal is the only one that can catch.",
      "step": [
        {
          "index": 0,
          "text": "throw error \"boom\", on error throw error \"recovery-failed\"",
          "line": {
            "number": 8
