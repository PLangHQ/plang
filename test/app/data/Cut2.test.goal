/ Cut 2 — lazy read + narrow + chain-wide !.
/ %file!path% resolves location-only (no content read); is file → true with no read.
/ %file.field% reads + parses + narrows; second use stays cached; the facet hop
/ still resolves after the narrow.
Start
- set %content% = '{"db":"plang","port":8080}' as json
- save 'cut2.json' with content %content%
- read file 'cut2.json', write to %cfg%
- set %loc% = %cfg!path%
- assert %loc% is not null
- if %cfg% is not file, call NotAFile
- set %db% = %cfg.db%
- assert %db% equals "plang"
- set %port% = %cfg.port%
- assert %port% equals 8080
- if %cfg% is not dict, call NotADict
- set %loc2% = %cfg!path%
- assert %loc2% is not null
- delete file 'cut2.json'

NotAFile
- throw "cfg is not a file"

NotADict
- throw "cfg is not a dict"
