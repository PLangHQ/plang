<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PLang</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PLangLibrary</AssemblyName>
    <!--<RuntimeIdentifier>win-x64</RuntimeIdentifier>-->
    <SignAssembly>False</SignAssembly>
    <FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<Authors>Ingi Gauti Ragnarsson</Authors>
		<Company>Plang</Company>
		<PackageId>PlangLibrary</PackageId>
		<Title>PlangLibrary</Title>
		<Description>Plang language core</Description>
		<PackageTags>plang</PackageTags>
		<RepositoryUrl>https://github.com/PLangHQ/plang/</RepositoryUrl>
		<PackageLicenseExpression>LGPL-2.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Deterministic>True</Deterministic>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RunAnalyzers>false</RunAnalyzers>
	</PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <Deterministic>True</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PLang.Tests.Shared" />
    <InternalsVisibleTo Include="PLang.Tests.Modules" />
    <InternalsVisibleTo Include="PLang.Tests.Types" />
    <InternalsVisibleTo Include="PLang.Tests.Wire" />
    <InternalsVisibleTo Include="PLang.Tests.Data" />
    <InternalsVisibleTo Include="PLang.Tests.Generator" />
    <InternalsVisibleTo Include="PLang.Tests.Runtime" />
    <InternalsVisibleTo Include="PLang.Tests.Bench" />
  </ItemGroup>

  <ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />

		<None Update=".playwright/**">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<ExcludeFromPublish>true</ExcludeFromPublish>
		</None>
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\PLang.Generators\PLang.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepCloner" Version="0.10.4" />
    <PackageReference Include="Fluid.Core" Version="2.31.0" />
    <PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    <PackageReference Include="Nethereum.Util" Version="4.29.0" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
    <PackageReference Include="QRCoder-ImageSharp" Version="0.10.0" />
    <PackageReference Include="System.Runtime.Caching" Version="9.0.2" />
  </ItemGroup>


  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Goals\**" />
    <Compile Remove="Modules\NewFolder1\**" />
    <EmbeddedResource Remove="Goals\**" />
    <EmbeddedResource Remove="Modules\NewFolder1\**" />
    <None Remove="Goals\**" />
    <None Remove="Modules\NewFolder1\**" />
  </ItemGroup>
	
	<Target Name="SetVersionFromFile" BeforeTargets="BeforeBuild;GetAssemblyVersion;GenerateAssemblyInfo">
		<PropertyGroup>
			<Version>$([System.IO.File]::ReadAllText('$(ProjectDir)version.txt').Trim())</Version>
			<AssemblyVersion>$(Version)</AssemblyVersion>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion>$(Version)</InformationalVersion>
		</PropertyGroup>

		<Message Text="Building version: $(Version)" Importance="high" />
	</Target>
</Project>
