<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PLang</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PLangLibrary</AssemblyName>
    <SelfContained>true</SelfContained>
    <!--<RuntimeIdentifier>win-x64</RuntimeIdentifier>-->
    <SignAssembly>False</SignAssembly>
    <FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<Authors>Ingi Gauti Ragnarsson</Authors>
		<Company>Plang</Company>
		<PackageId>PlangLibrary</PackageId>
		<Title>PlangLibrary</Title>
		<Description>Plang language core</Description>
		<PackageTags>plang</PackageTags>
		<RepositoryUrl>https://github.com/PLangHQ/plang/</RepositoryUrl>
		<PackageLicenseExpression>LGPL-2.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <Deterministic>True</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <Deterministic>True</Deterministic>
  </PropertyGroup>

  <ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />

		<None Update=".playwright/**">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<ExcludeFromPublish>true</ExcludeFromPublish>
		</None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageReference Include="Castle.Core" Version="5.2.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="DeepCloner" Version="0.10.4" />
    <PackageReference Include="Epiforge.Extensions.Components" Version="4.5.1" />
    <PackageReference Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
    <PackageReference Include="IdGen" Version="3.0.7" />
    <PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Jil" Version="2.17.0" />
    <PackageReference Include="LightInject" Version="7.1.1" />
    <PackageReference Include="Markdig.Signed" Version="1.6.0" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageReference Include="N0.IrohNet" Version="0.101.13" />
    <PackageReference Include="MimeKit" Version="5.0.0" />
    <PackageReference Include="MiniExcel" Version="1.47.1" />
    <PackageReference Include="NCalcSync" Version="7.4.0" />
    <PackageReference Include="NCrontab.Signed" Version="3.4.0" />
    <PackageReference Include="Nethereum.Accounts" Version="7.1.0" />
    <PackageReference Include="Nethereum.Contracts" Version="7.1.0" />
    <PackageReference Include="Nethereum.HdWallet" Version="7.1.0" />
    <PackageReference Include="Nethereum.JsonRpc.RpcClient" Version="7.1.0" />
    <PackageReference Include="Nethereum.JsonRpc.WebSocketClient" Version="7.1.0" />
    <PackageReference Include="Nethereum.RPC.Reactive" Version="7.1.0" />
    <PackageReference Include="Nethereum.Signer" Version="7.1.0" />
    <PackageReference Include="Nethereum.Util.Rest" Version="7.1.0" />
    <PackageReference Include="NJsonSchema" Version="11.6.2" />
    <PackageReference Include="NNostr.Client" Version="0.0.55" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="pythonnet" Version="3.2.1" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="RazorEngineCore" Version="2026.1.1" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
    <PackageReference Include="Scriban.Signed" Version="7.6.1" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
