    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.IO.Abstractions" Version="23.0.1" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="UAParser.Core" Version="4.0.7" />
    <PackageReference Include="UTF.Unknown" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\InternalApps.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>InternalApps.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\InternalApps.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>InternalApps.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Goals\**" />
    <Compile Remove="Modules\NewFolder1\**" />
    <EmbeddedResource Remove="Goals\**" />
    <EmbeddedResource Remove="Modules\NewFolder1\**" />
    <None Remove="Goals\**" />
    <None Remove="Modules\NewFolder1\**" />
  </ItemGroup>
	
	<Target Name="SetVersionFromFile" BeforeTargets="BeforeBuild;GetAssemblyVersion;GenerateAssemblyInfo">
		<PropertyGroup>
			<Version>$([System.IO.File]::ReadAllText('$(ProjectDir)version.txt').Trim())</Version>
			<AssemblyVersion>$(Version)</AssemblyVersion>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion>$(Version)</InformationalVersion>
		</PropertyGroup>

		<Message Text="Building version: $(Version)" Importance="high" />
	</Target>
</Project>
