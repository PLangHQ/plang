  "name": "MissingVarIsNotNullValue",
  "step": [
    {
      "index": 0,
      "text": "set %x% = null",
      "line": {
        "number": 5
      },
      "comment": "An explicit null is a real, typed, present value (Type \"null\") occupying the variable — it is\nNOT the same as a never-set variable (which resolves to not-found). Here we pin the value side:\nassigning null yields a present null-typed value that reads back as null.",
