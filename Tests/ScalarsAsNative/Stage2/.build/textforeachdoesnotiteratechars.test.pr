{
  "name": "TextForEachDoesNotIterateChars",
  "step": [
    {
      "index": 0,
      "text": "set %count% = 0",
      "line": {
        "number": 4
      },
      "comment": "text is atomic — a list of two texts iterates as TWO items, not the 5 characters of\n\"abc\"+\"de\". text.@this is not IEnumerable; a text is never char-decomposed.",
      "code": [
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%count%"
            },
            {
              "name": "Value",
              "type": {
                "name": "number"
              },
              "value": 0
            }
          ],
          "default": [
            {
              "name": "asdefault",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ],
      "waitForExecution": true
    },
    {
      "index": 1,
