{
  "name": "Start",
  "step": [
    {
      "index": 0,
      "text": "set channel \"logger\" call Logger",
      "line": {
        "number": 4
      },
      "comment": "Builder maps the write step's intent to a custom channel name from inventory.\nChannel inventory teaches the LLM, not pattern parsing.",
      "code": [
